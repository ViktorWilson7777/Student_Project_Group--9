package controller;

import dal.ProductDAO;
import dal.ProductVariantDAO;
import dal.VoucherDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;

import java.io.IOException;
import java.util.ArrayList;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;

import model.CartItem;
import model.Product;
import model.ProductVariant;
import model.Voucher;

@WebServlet("/cart")
public class CartController extends HttpServlet {

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        HttpSession session = request.getSession();

        List<CartItem> cart = (List<CartItem>) session.getAttribute("cart");

        if (cart == null) {
            cart = new ArrayList<>();
            session.setAttribute("cart", cart);
        }

        try {

            String action = request.getParameter("action");

            if ("deleteSelected".equals(action)) {
                String[] selectedIds = request.getParameterValues("selectedItems");

                if (selectedIds != null) {
                    for (String id : selectedIds) {
                        int variantId = Integer.parseInt(id);
                        cart.removeIf(item -> item.getVariantId() == variantId);
                    }
                }

                session.setAttribute("cart", cart);
                response.sendRedirect("cart");
                return;
            }

            if ("applyVoucher".equals(action)) {
                String[] voucherIds = request.getParameterValues("voucherId");

                List<Voucher> selected = new ArrayList<>();

                if (voucherIds != null) {
                    VoucherDAO vdao = new VoucherDAO();

                    Set<Integer> uniqueIds = new LinkedHashSet<>();
                    for (String id : voucherIds) {
                        try {
                            uniqueIds.add(Integer.parseInt(id));
                        } catch (Exception e) {
                            e.printStackTrace();
                        }
                    }

                    if (uniqueIds.size() > 3) {
                        session.setAttribute("voucherError", "You can apply at most 3 vouchers only.");
                        response.sendRedirect("cart");
                        return;
                    }

                    for (Integer id : uniqueIds) {
                        Voucher v = vdao.getById(id);
                        if (v != null) {
                            selected.add(v);
                        }
                    }
                }

                if (selected.isEmpty()) {
                    session.removeAttribute("vouchersSelected");
                } else {
                    session.setAttribute("vouchersSelected", selected);
                }

                session.removeAttribute("voucherError");
                response.sendRedirect("cart");
                return;
            }

            if ("delete".equals(action)) {
                int variantId = Integer.parseInt(request.getParameter("variantId"));

                for (int i = 0; i < cart.size(); i++) {
                    if (cart.get(i).getVariantId() == variantId) {
                        cart.remove(i);
                        break;
                    }
                }

                session.setAttribute("cart", cart);
                response.sendRedirect("cart");
                return;
            }

            String variantParam = request.getParameter("variantId");
            String quantityParam = request.getParameter("quantity");

            if (variantParam != null && quantityParam != null) {
                int variantId = Integer.parseInt(variantParam);
                int quantity = Integer.parseInt(quantityParam);

                ProductVariantDAO dao = new ProductVariantDAO();
                ProductVariant pv = dao.getById(variantId);

                if (pv != null && pv.getProduct() != null) {
                    ProductDAO pdao = new ProductDAO();
                    Product product = pdao.getByProductId(pv.getProduct().getProductId());

                    CartItem item = new CartItem();
                    item.setVariantId(variantId);
                    item.setProductName(product.getName());
                    item.setPriceVariant(pv.getPriceVariant());
                    item.setImageUrl(product.getImageUrl());
                    item.setQuantity(quantity);
                    item.setSize(pv.getSize());
                    item.setColor(pv.getColor());

                    boolean found = false;

                    for (CartItem c : cart) {
                        if (c.getVariantId() == variantId) {
                            c.setQuantity(c.getQuantity() + quantity);
                            found = true;
                            break;
                        }
                    }

                    if (!found) {
                        cart.add(item);
                    }
                }
            }

            session.setAttribute("cart", cart);
            request.setAttribute("cartItems", cart);

            Object buyNowVariantId = session.getAttribute("buyNowVariantId");
            if (buyNowVariantId != null) {
                request.setAttribute("buyNowVariantId", buyNowVariantId);
                session.removeAttribute("buyNowVariantId");
            }

            recalculateCart(session, request, cart);
            request.getRequestDispatcher("cart.jsp").forward(request, response);

        } catch (Exception ex) {
            ex.printStackTrace();
            request.setAttribute("error", ex.getMessage());
            request.getRequestDispatcher("cart.jsp").forward(request, response);
        }
    }

    private void recalculateCart(HttpSession session, HttpServletRequest request, List<CartItem> cart) {
        try {
            double originalTotal = 0;
            
            for (CartItem item : cart) {
                originalTotal += item.getPriceVariant() * item.getQuantity();
            }
            
            double total = originalTotal;
            double saved = 0;
            
            List<Voucher> selected = (List<Voucher>) session.getAttribute("vouchersSelected");
            List<Voucher> validSelected = new ArrayList<>();
            
            if (selected != null && originalTotal > 0) {
                for (Voucher voucher : selected) {
                    if (voucher != null && originalTotal >= voucher.getMinOrderAmount()) {
                        validSelected.add(voucher);
                    }
                }
            }
            
            if (cart.isEmpty() || validSelected.isEmpty()) {
                session.removeAttribute("vouchersSelected");
            } else {
                session.setAttribute("vouchersSelected", validSelected);
            }
            
            if (!cart.isEmpty() && !validSelected.isEmpty()) {
                double maxMinOrder = 0;
                
                for (Voucher voucher : validSelected) {
                    if (voucher.getMinOrderAmount() > maxMinOrder) {
                        maxMinOrder = voucher.getMinOrderAmount();
                    }
                    
                    double discount = total * voucher.getDiscountPercent() / 100.0;
                    saved += discount;
                    total -= discount;
                }
                
                if (total < maxMinOrder) {
                    total = maxMinOrder;
                    saved = Math.max(0, originalTotal - total);
                }
            } else {
                total = originalTotal;
                saved = 0;
            }
            
            session.setAttribute("saved", saved);
            session.setAttribute("originalPrice", originalTotal);
            session.setAttribute("totalPrice", total);
            
            request.setAttribute("saved", saved);
            request.setAttribute("originalPrice", originalTotal);
            request.setAttribute("totalPrice", total);
            
            VoucherDAO vdao = new VoucherDAO();
            List<Voucher> list = vdao.getAvailableVouchers();
            List<Voucher> filtered = new ArrayList<>();
            
            for (Voucher voucher : list) {
                if (originalTotal >= voucher.getMinOrderAmount()) {
                    filtered.add(voucher);
                }
            }
            
            request.setAttribute("vouchers", filtered);
        } catch (Exception ex) {
            System.getLogger(CartController.class.getName()).log(System.Logger.Level.ERROR, (String) null, ex);
        }
    }
}
