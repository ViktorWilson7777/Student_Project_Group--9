package controller;

import dal.VoucherDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;
import java.io.IOException;
import java.util.ArrayList;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;
import model.Voucher;

@WebServlet("/apply-voucher")
public class ApplyVoucherController extends HttpServlet {

    @Override
    protected void doPost(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        try {
            HttpSession session = request.getSession();

            String[] voucherIds = request.getParameterValues("voucherIds");

            // Nếu không chọn voucher nào thì xóa voucher cũ
            if (voucherIds == null || voucherIds.length == 0) {
                session.removeAttribute("vouchersSelected");
                session.removeAttribute("voucherError");
                response.sendRedirect("cart");
                return;
            }

            // Bỏ trùng
            Set<Integer> uniqueIds = new LinkedHashSet<>();
            for (String id : voucherIds) {
                try {
                    uniqueIds.add(Integer.parseInt(id));
                } catch (Exception ignored) {
                }
            }

            // Chặn quá 3 voucher
            if (uniqueIds.size() > 3) {
                session.setAttribute("voucherError", "You can apply at most 3 vouchers only.");
                response.sendRedirect("cart");
                return;
            }

            VoucherDAO dao = new VoucherDAO();
            List<Voucher> selected = new ArrayList<>();

            int stackCount = 0;
            boolean hasNonStack = false;

            for (Integer id : uniqueIds) {
                Voucher v = dao.getById(id);
                if (v != null) {
                    selected.add(v);

                    if (v.isStackable()) {
                        stackCount++;
                    } else {
                        hasNonStack = true;
                    }
                }
            }

            // Nếu có voucher non-stack thì chỉ được chọn đúng 1 voucher
            if (hasNonStack && selected.size() > 1) {
                session.setAttribute("voucherError", "Non-stack voucher cannot be combined with other vouchers.");
                response.sendRedirect("cart");
                return;
            }

            // Voucher stack tối đa 3
            if (stackCount > 3) {
                session.setAttribute("voucherError", "You can apply at most 3 stackable vouchers only.");
                response.sendRedirect("cart");
                return;
            }

            // Thay thế hoàn toàn danh sách voucher cũ
            session.setAttribute("vouchersSelected", selected);
            session.removeAttribute("voucherError");

            response.sendRedirect("cart");

        } catch (Exception e) {
            e.printStackTrace();
            request.getSession().setAttribute("voucherError", "Failed to apply voucher.");
            response.sendRedirect("cart");
        }
    }
}
