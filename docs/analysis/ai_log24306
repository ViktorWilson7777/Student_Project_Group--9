const maxVoucher = 3;

function updateVoucherState() {
    const checkboxes = document.querySelectorAll(".voucher-checkbox");
    const checkedBoxes = document.querySelectorAll(".voucher-checkbox:checked");
    const selectedCount = checkedBoxes.length;

