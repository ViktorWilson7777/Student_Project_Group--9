package controller;

import dal.VoucherDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;
import java.io.IOException;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;
import model.Voucher;

@WebServlet("/apply-voucher")
public class ApplyVoucherController extends HttpServlet {

    @Override
    protected void doPost(HttpServletRequest request,
                          HttpServletResponse response)
            throws ServletException, IOException {

        try {
            String[] ids = request.getParameterValues("voucherIds");

            if (ids == null || ids.length == 0) {
                request.getSession().removeAttribute("vouchersSelected");
                response.sendRedirect("cart");
                return;
            }

            VoucherDAO dao = new VoucherDAO();
            List<Voucher> selected = new ArrayList<>();

            int stackCount = 0;
            int nonStackCount = 0;
            Date now = new Date();

            for (String id : ids) {
                Voucher v = dao.getById(Integer.parseInt(id));
                if (v == null) continue;

                if (now.before(v.getStartDate()) || now.after(v.getEndDate())) {
                    request.setAttribute("error", "Voucher " + v.getCode() + " không còn hiệu lực");
                    request.getRequestDispatcher("cart").forward(request, response);
                    return;
                }

                if (v.isStackable()) {
                    stackCount++;
                } else {
                    nonStackCount++;
                }

                selected.add(v);
            }

            if (nonStackCount > 1) {
                request.setAttribute("error", "Chỉ được chọn 1 voucher non-stack");
                request.getRequestDispatcher("cart").forward(request, response);
                return;
            }

            if (stackCount > 3) {
                request.setAttribute("error", "Chỉ được chọn tối đa 3 voucher stack");
                request.getRequestDispatcher("cart").forward(request, response);
                return;
            }

            if (stackCount > 0 && nonStackCount > 0) {
                request.setAttribute("error", "Không được chọn đồng thời voucher stack và non-stack");
                request.getRequestDispatcher("cart").forward(request, response);
                return;
            }

            request.getSession().setAttribute("vouchersSelected", selected);
            response.sendRedirect("cart");

        } catch (Exception e) {
            e.printStackTrace();
            response.sendRedirect("cart");
        }
    }
}
