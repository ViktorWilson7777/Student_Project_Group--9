        request.setAttribute("shop", shop);
        request.getRequestDispatcher("me.jsp").forward(request, response);
    }
}
c) AddToCartController.java
Phần này vẫn nên sửa vì cart đang lệch kiểu dữ liệu giữa Map và List, còn CartController lại đọc kiểu List<CartItem>. 

 


Dùng bản này:

package controller;

import dal.ProductDAO;
import dal.ProductVariantDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;
import model.CartItem;
import model.Product;
import model.ProductVariant;

import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

@WebServlet("/add-to-cart")
public class AddToCartController extends HttpServlet {

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        try {
            int variantId = Integer.parseInt(request.getParameter("variantId"));
            int quantity = Integer.parseInt(request.getParameter("quantity"));

            if (quantity <= 0) {
                response.sendRedirect("cart");
                return;
            }

            ProductVariantDAO variantDAO = new ProductVariantDAO();
            ProductVariant variant = variantDAO.getById(variantId);

            if (variant == null || variant.getProduct() == null) {
                response.sendRedirect("cart");
                return;
            }

            ProductDAO productDAO = new ProductDAO();
            Product product = productDAO.getByProductId(variant.getProduct().getProductId());

            if (product == null) {
                response.sendRedirect("cart");
                return;
            }

            HttpSession session = request.getSession();
            List<CartItem> cart = (List<CartItem>) session.getAttribute("cart");

            if (cart == null) {
                cart = new ArrayList<>();
            }

            boolean found = false;

            for (CartItem item : cart) {
                if (item.getVariantId() == variantId) {
                    if (item.getQuantity() + quantity > variant.getStock()) {
                        response.sendRedirect("product-detail?productId=" + product.getProductId());
                        return;
                    }
                    item.setQuantity(item.getQuantity() + quantity);
                    found = true;
                    break;
                }
            }

            if (!found) {
                if (quantity > variant.getStock()) {
                    response.sendRedirect("product-detail?productId=" + product.getProductId());
                    return;
                }

                CartItem item = new CartItem(
                        variant.getVariantId(),
                        product.getName(),
                        product.getImageUrl(),
                        variant.getSize(),
                        variant.getColor(),
                        variant.getPriceVariant(),
                        quantity
                );
                cart.add(item);
            }

            session.setAttribute("cart", cart);
            response.sendRedirect("cart");

        } catch (Exception e) {
            e.printStackTrace();
            response.sendRedirect("cart");
        }
    }
}
