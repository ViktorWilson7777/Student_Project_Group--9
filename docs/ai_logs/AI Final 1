Bạn đừng sửa từng dòng nữa, thay luôn toàn bộ file AddToCartController.java bằng bản dưới đây để hết lỗi compile và đúng luôn flow Add To Cart / Buy:

package controller;

import dal.ProductDAO;
import dal.ProductVariantDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;
import model.CartItem;
import model.Product;
import model.ProductVariant;

import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

@WebServlet("/add-to-cart")
public class AddToCartController extends HttpServlet {

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        try {
            int variantId = Integer.parseInt(request.getParameter("variantId"));
            int quantity = Integer.parseInt(request.getParameter("quantity"));
            boolean buyNow = "true".equalsIgnoreCase(request.getParameter("buyNow"));

            if (quantity <= 0) {
                quantity = 1;
            }

            ProductVariantDAO variantDAO = new ProductVariantDAO();
            ProductVariant variant = variantDAO.getById(variantId);

            if (variant == null || variant.getProduct() == null) {
                response.sendRedirect("user-home");
                return;
            }

            ProductDAO productDAO = new ProductDAO();
            Product product = productDAO.getByProductId(variant.getProduct().getProductId());

            if (product == null) {
                response.sendRedirect("user-home");
                return;
            }

            HttpSession session = request.getSession();
            List<CartItem> cart = (List<CartItem>) session.getAttribute("cart");

            if (cart == null) {
                cart = new ArrayList<>();
            }

            CartItem found = null;
            for (CartItem item : cart) {
                if (item.getVariantId() == variantId) {
                    found = item;
                    break;
                }
            }

            int currentQuantity = (found == null) ? 0 : found.getQuantity();

            if (currentQuantity + quantity > variant.getStock()) {
                boolean ajax = "XMLHttpRequest".equals(request.getHeader("X-Requested-With"));

                if (ajax) {
                    response.setContentType("application/json;charset=UTF-8");
                    response.getWriter().write("{\"success\":false,\"message\":\"Quantity exceeds available stock\"}");
                } else {
                    response.sendRedirect("product-detail?productId=" + product.getProductId());
                }
                return;
            }

            if (found != null) {
                found.setQuantity(found.getQuantity() + quantity);
            } else {
                CartItem item = new CartItem(
                        variant.getVariantId(),
                        product.getName(),
                        product.getImageUrl(),
                        variant.getSize(),
                        variant.getColor(),
                        variant.getPriceVariant(),
                        quantity
                );
                cart.add(item);
            }

            session.setAttribute("cart", cart);

            if (buyNow) {
                response.sendRedirect("cart?selectedVariantId=" + variantId);
                return;
            }

            boolean ajax = "XMLHttpRequest".equals(request.getHeader("X-Requested-With"));
            if (ajax) {
                response.setContentType("application/json;charset=UTF-8");
                response.getWriter().write("{\"success\":true,\"message\":\"Added to cart successfully\"}");
            } else {
                response.sendRedirect("cart");
            }

        } catch (Exception e) {
            e.printStackTrace();

            boolean ajax = "XMLHttpRequest".equals(request.getHeader("X-Requested-With"));
            if (ajax) {
                response.setContentType("application/json;charset=UTF-8");
                response.getWriter().write("{\"success\":false,\"message\":\"Cannot add to cart\"}");
            } else {
                response.sendRedirect("user-home");
            }
        }
    }
}
Mấu chốt là 3 dòng này phải đúng escape:

response.getWriter().write("{\"success\":false,\"message\":\"Quantity exceeds available stock\"}");
response.getWriter().write("{\"success\":true,\"message\":\"Added to cart successfully\"}");
response.getWriter().write("{\"success\":false,\"message\":\"Cannot add to cart\"}");
