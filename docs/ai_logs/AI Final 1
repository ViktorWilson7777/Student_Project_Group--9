    let currentPage = ${page == null ? 1 : page};
    let loading = false;

    const viewMode = '${viewMode}';
    const currentKeyword = '${keyword == null ? "" : keyword}';
    const currentProductId = '${productId == null ? "" : productId}';

    async function loadMore() {
        if (loading) return;
        loading = true;

        document.getElementById("loading").style.display = "block";

        currentPage++;

        let url = 'product-variant-list?page=' + currentPage;

        if (viewMode === 'product' && currentProductId !== '') {
            url += '&productId=' + encodeURIComponent(currentProductId);
        } else if (currentKeyword !== '') {
            url += '&keyword=' + encodeURIComponent(currentKeyword);
        }

        try {
            const response = await fetch(url);
            const html = await response.text();

            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newRows = doc.querySelectorAll('#variantTableBody tr');

            if (newRows.length === 0 || (newRows.length === 1 && newRows[0].innerText.includes('No variants found'))) {
                window.removeEventListener('scroll', handleScroll);
                document.getElementById("loading").innerText = "No more data";
                return;
            }

            const tbody = document.getElementById('variantTableBody');

            const emptyRow = tbody.querySelector('.empty-row');
            if (emptyRow) {
                emptyRow.parentElement.remove();
            }

            newRows.forEach(row => {
                if (!row.innerText.includes('No variants found')) {
                    tbody.appendChild(row);
                }
            });

            document.getElementById("loading").style.display = "none";
            loading = false;

        } catch (e) {
            console.error(e);
            document.getElementById("loading").style.display = "none";
            loading = false;
        }
    }

    function handleScroll() {
        if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 200) {
            loadMore();
        }
    }

    window.addEventListener('scroll', handleScroll);
</script>
