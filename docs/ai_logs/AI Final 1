    if (item.getVariantId() == variantId) {

        if (item.getQuantity() + quantity > stock) {
            response.sendRedirect("product-detail?productId=" + variant.getProduct().getProductId());
            return;
        }

        item.setQuantity(item.getQuantity() + quantity);
        found = true;
        break;
    }
