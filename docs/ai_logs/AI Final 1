    CartItem item = new CartItem(
        variant.getVariantId(),
        variant.getProduct().getName(),
        variant.getProduct().getImageUrl(),
        variant.getSize(),
        variant.getColor(),
        variant.getPriceVariant(),
        quantity
    );
    cart.add(item);
}

session.setAttribute("cart", cart);
response.sendRedirect("cart");
