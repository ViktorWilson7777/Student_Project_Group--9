package controller;

import dal.VoucherDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;

import java.io.IOException;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

import model.CartItem;
import model.Voucher;

@WebServlet("/cart")
public class CartController extends HttpServlet {

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        HttpSession session = request.getSession();

        List<CartItem> cart = new ArrayList<>();
        Object rawCart = session.getAttribute("cart");

        if (rawCart instanceof List<?>) {
            cart = (List<CartItem>) rawCart;
        } else if (rawCart instanceof Map<?, ?>) {
            Map<?, ?> map = (Map<?, ?>) rawCart;
            for (Object value : map.values()) {
                if (value instanceof CartItem) {
                    cart.add((CartItem) value);
                }
            }
            session.setAttribute("cart", cart);
        } else {
            session.setAttribute("cart", cart);
        }

        try {
            String action = request.getParameter("action");

            if ("deleteSelected".equals(action)) {
                String[] selectedIds = request.getParameterValues("selectedItems");
                if (selectedIds != null) {
                    for (String id : selectedIds) {
                        int variantId = Integer.parseInt(id);
                        cart.removeIf(item -> item.getVariantId() == variantId);
                    }
                }
                session.setAttribute("cart", cart);
                response.sendRedirect("cart");
                return;
            }

            if ("delete".equals(action)) {
                int variantId = Integer.parseInt(request.getParameter("variantId"));
                cart.removeIf(item -> item.getVariantId() == variantId);
                session.setAttribute("cart", cart);
                response.sendRedirect("cart");
                return;
            }

            double originalTotal = 0;
            for (CartItem item : cart) {
                originalTotal += item.getPriceVariant() * item.getQuantity();
            }

            double total = originalTotal;
            double saved = 0;

            List<Voucher> selected = (List<Voucher>) session.getAttribute("vouchersSelected");

            if (selected != null && !selected.isEmpty()) {
                double totalDiscountPercent = 0;
                double maxMinOrder = 0;
                List<Voucher> validSelected = new ArrayList<>();

                for (Voucher v : selected) {
                    if (originalTotal >= v.getMinOrderAmount()) {
                        totalDiscountPercent += v.getDiscountPercent();
                        if (v.getMinOrderAmount() > maxMinOrder) {
                            maxMinOrder = v.getMinOrderAmount();
                        }
                        validSelected.add(v);
                    }
                }

                total = originalTotal * (1 - totalDiscountPercent / 100.0);

                if (total < maxMinOrder) {
                    total = maxMinOrder;
                }

                saved = originalTotal - total;
                session.setAttribute("vouchersSelected", validSelected);
            }

            session.setAttribute("saved", saved);
            session.setAttribute("originalPrice", originalTotal);
            session.setAttribute("totalPrice", total);

            request.setAttribute("cartItems", cart);
            request.setAttribute("saved", saved);
            request.setAttribute("originalPrice", originalTotal);
            request.setAttribute("totalPrice", total);

            VoucherDAO vdao = new VoucherDAO();
            List<Voucher> all = vdao.getAvailableVouchers();

            List<Voucher> filtered = new ArrayList<>();
            List<Voucher> stackableVouchers = new ArrayList<>();
            List<Voucher> nonStackableVouchers = new ArrayList<>();

            for (Voucher v : all) {
                if (originalTotal >= v.getMinOrderAmount()) {
                    filtered.add(v);
                    if (v.isStackable()) {
                        stackableVouchers.add(v);
                    } else {
                        nonStackableVouchers.add(v);
                    }
                }
            }

            request.setAttribute("vouchers", filtered);
            request.setAttribute("stackableVouchers", stackableVouchers);
            request.setAttribute("nonStackableVouchers", nonStackableVouchers);

            request.getRequestDispatcher("cart.jsp").forward(request, response);

        } catch (Exception ex) {
            ex.printStackTrace();
            request.setAttribute("error", ex.getMessage());
            request.getRequestDispatcher("cart.jsp").forward(request, response);
        }
    }
}
