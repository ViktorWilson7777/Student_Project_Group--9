package controller;

import dal.VoucherDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;
import java.io.IOException;
import java.util.*;
import model.CartItem;
import model.Voucher;

@WebServlet("/apply-voucher")
public class ApplyVoucherController extends HttpServlet {

    @Override
    protected void doPost(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        try {
            HttpSession session = request.getSession();

            List<CartItem> cart = (List<CartItem>) session.getAttribute("cart");
            if (cart == null) {
                cart = new ArrayList<>();
            }

            String[] selectedItemIds = request.getParameterValues("selectedItems");
            Set<Integer> selectedIds = new LinkedHashSet<>();

            if (selectedItemIds != null) {
                for (String id : selectedItemIds) {
                    try {
                        selectedIds.add(Integer.parseInt(id));
                    } catch (Exception ignored) {
                    }
                }
            }

            session.setAttribute("selectedCartItemIds", new ArrayList<>(selectedIds));

            String[] voucherIds = request.getParameterValues("voucherIds");

            List<Voucher> selected = new ArrayList<>();
            if (voucherIds != null) {
                VoucherDAO dao = new VoucherDAO();
                for (String id : voucherIds) {
                    Voucher v = dao.getById(Integer.parseInt(id));
                    if (v != null) {
                        selected.add(v);
                    }
                }
            }

            double originalTotal = 0;
            for (CartItem item : cart) {
                if (selectedIds.contains(item.getVariantId())) {
                    originalTotal += item.getPriceVariant() * item.getQuantity();
                }
            }

            if (selectedIds.isEmpty()) {
                session.setAttribute("voucherError", "Please tick product(s) before applying voucher.");
                response.sendRedirect("cart");
                return;
            }

            double total = originalTotal;
            double saved = 0;
            double maxMinOrder = 0;

            for (Voucher v : selected) {
                if (v.getMinOrderAmount() > maxMinOrder) {
                    maxMinOrder = v.getMinOrderAmount();
                }

                if (originalTotal >= v.getMinOrderAmount()) {
                    double discount = total * v.getDiscountPercent() / 100.0;
                    saved += discount;
                    total -= discount;
                }
            }

            if (total < maxMinOrder) {
                total = maxMinOrder;
                saved = originalTotal - total;
            }

            session.setAttribute("vouchersSelected", selected);
            session.setAttribute("saved", saved);
            session.setAttribute("originalPrice", originalTotal);
            session.setAttribute("totalPrice", total);

            response.sendRedirect("cart");

        } catch (Exception e) {
            e.printStackTrace();
            response.sendRedirect("cart");
        }
    }
}
