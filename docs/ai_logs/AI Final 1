package controller;

import dal.ProductVariantDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.util.List;
import model.ProductVariant;

@WebServlet("/product-variant-list")
public class ProductVariantListController extends HttpServlet {

    @Override
    protected void doGet(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        String keyword = request.getParameter("keyword");
        if (keyword == null) {
            keyword = "";
        }

        int page = 1;
        int pageSize = 20;

        try {
            String pageRaw = request.getParameter("page");
            if (pageRaw != null && !pageRaw.trim().isEmpty()) {
                page = Integer.parseInt(pageRaw);
            }
        } catch (Exception e) {
            page = 1;
        }

        ProductVariantDAO dao = new ProductVariantDAO();

        String productIdRaw = request.getParameter("productId");

        if (productIdRaw != null && !productIdRaw.trim().isEmpty()) {
            int productId = Integer.parseInt(productIdRaw);

            List<ProductVariant> list = dao.getByProductIdPaging(productId, page, pageSize);
            int total = dao.countByProductId(productId);
            int totalPages = (int) Math.ceil((double) total / pageSize);

            request.setAttribute("variants", list);
            request.setAttribute("page", page);
            request.setAttribute("totalPages", totalPages);
            request.setAttribute("productId", productId);
            request.setAttribute("viewMode", "product");

            request.getRequestDispatcher("product-variant-list.jsp")
                    .forward(request, response);
            return;
        }

        List<ProductVariant> list = dao.searchVariant(keyword, page, pageSize);

        request.setAttribute("variants", list);
        request.setAttribute("keyword", keyword);
        request.setAttribute("page", page);
        request.setAttribute("viewMode", "search");

        request.getRequestDispatcher("product-variant-list.jsp")
                .forward(request, response);
    }
}
