Còn việc login vào lâu thì gần như chắc do sau login nó nhảy sang user-home, mà user-home đang lấy sản phẩm random theo thời gian thực bằng query nặng.

Sửa đúng 2 chỗ
1) UserHomeController.java
Thay toàn bộ file bằng bản này:

package controller;

import dal.ProductDAO;
import dal.ProductVariantDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;
import java.io.IOException;
import java.util.List;
import java.util.Random;
import model.AppUser;
import model.Product;
import model.ProductVariant;

@WebServlet("/user-home")
public class UserHomeController extends HttpServlet {

    private final ProductDAO productDAO = new ProductDAO();
    private final ProductVariantDAO variantDAO = new ProductVariantDAO();
    private final Random random = new Random();

    @Override
    protected void doGet(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        HttpSession session = request.getSession(false);

        if (session == null || session.getAttribute("account") == null) {
            response.sendRedirect("login");
            return;
        }

        AppUser user = (AppUser) session.getAttribute("account");

        if ("admin".equalsIgnoreCase(user.getRole())) {
            response.sendRedirect("home");
            return;
        }

        String productIdParam = request.getParameter("productId");

        if (productIdParam != null && !productIdParam.trim().isEmpty()) {
            int productId = Integer.parseInt(productIdParam);

            Product product = productDAO.getByProductId(productId);
            List<ProductVariant> variants = variantDAO.getByProductId(productId);

            request.setAttribute("productDetail", product);
            request.setAttribute("variants", variants);

            request.getRequestDispatcher("user/user-home.jsp").forward(request, response);
            return;
        }

        String productKeyword = request.getParameter("productKeyword");
        String shopKeyword = request.getParameter("shopKeyword");

        if (productKeyword == null) {
            productKeyword = "";
        }
        if (shopKeyword == null) {
            shopKeyword = "";
        }

        int page = 1;
        int pageSize = 20;

        String pageParam = request.getParameter("page");
        if (pageParam != null && !pageParam.trim().isEmpty()) {
            try {
                page = Integer.parseInt(pageParam);
            } catch (Exception ignored) {
                page = 1;
            }
        }

        List<Product> products;
        int totalProducts;
        int totalPages;

        boolean isSearching = !productKeyword.isEmpty() || !shopKeyword.isEmpty();

        if (isSearching) {
            int offset = (page - 1) * pageSize;

            products = productDAO.searchProductAndShop(productKeyword, shopKeyword, offset, pageSize);
            totalProducts = productDAO.countSearchProduct(productKeyword, shopKeyword);
            totalPages = (int) Math.ceil((double) totalProducts / pageSize);

        } else {
            totalProducts = productDAO.countProducts();
            totalPages = (int) Math.ceil((double) totalProducts / pageSize);

            if (totalPages <= 0) {
                totalPages = 1;
            }

            // random theo thời gian thực nhưng vẫn có phân trang:
            // mỗi lần vào user-home không search và chưa chọn page thì random 1 page
            if (request.getParameter("page") == null || request.getParameter("page").trim().isEmpty()) {
                page = 1 + random.nextInt(totalPages);
            }

            int offset = (page - 1) * pageSize;
            products = productDAO.getProductPaging(offset, pageSize);
        }

        request.setAttribute("products", products);
        request.setAttribute("productKeyword", productKeyword);
        request.setAttribute("shopKeyword", shopKeyword);
        request.setAttribute("totalPages", totalPages);
        request.setAttribute("currentPage", page);

        request.getRequestDispatcher("user/user-home.jsp").forward(request, response);
    }
}
Vì sao bản này hết 2 lỗi
Không search: vẫn random “theo thời gian thực”, nhưng là random 1 page, không phải random toàn bảng, nên nhẹ hơn nhiều.

Vẫn luôn set:

totalPages

currentPage

nên block phân trang trong JSP sẽ hiện lại bình thường. 


2) ProductDAO.java
Nếu hàm getProductPaging(offset, pageSize) của bạn đang dùng ORDER BY NEWID() hoặc random kiểu toàn bảng, thì sửa lại cho nhẹ hơn.

Dùng đúng 2 hàm này trong ProductDAO.java:

public List<Product> getProductPaging(int offset, int pageSize) {
    List<Product> list = new ArrayList<>();

    String sql = """
        SELECT p.productId, p.name, p.price, p.imageUrl,
               s.shopId, s.shopName
        FROM Product p
        JOIN Shop s ON p.shopId = s.shopId
        ORDER BY p.productId DESC
        OFFSET ? ROWS FETCH NEXT ? ROWS ONLY
    """;

    try (Connection con = DBContext.getConnection();
         PreparedStatement ps = con.prepareStatement(sql)) {

        ps.setInt(1, offset);
        ps.setInt(2, pageSize);

        ResultSet rs = ps.executeQuery();

        while (rs.next()) {
            Product p = new Product();
            p.setProductId(rs.getInt("productId"));
            p.setName(rs.getString("name"));
            p.setPrice(rs.getDouble("price"));
            p.setImageUrl(rs.getString("imageUrl"));

            model.Shop s = new model.Shop();
            s.setShopId(rs.getInt("shopId"));
            s.setShopName(rs.getString("shopName"));

            p.setShop(s);
            list.add(p);
        }

    } catch (Exception e) {
        e.printStackTrace();
    }

    return list;
}

public int countProducts() {
    String sql = "SELECT COUNT(*) FROM Product";

    try (Connection con = DBContext.getConnection();
         PreparedStatement ps = con.prepareStatement(sql);
         ResultSet rs = ps.executeQuery()) {

        if (rs.next()) {
            return rs.getInt(1);
        }

    } catch (Exception e) {
        e.printStackTrace();
    }

    return 0;
}
