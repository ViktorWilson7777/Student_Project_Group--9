import java.util.ArrayList;
import java.util.List;
import model.Product;
import model.ProductVariant;
import model.Shop;

public class ProductVariantDAO extends DBContext {

    public List<ProductVariant> searchVariant(String keyword) {
        List<ProductVariant> list = new ArrayList<>();

        String sql = """
        SELECT pv.*, p.name AS productName, s.shopName
        FROM ProductVariant pv
        JOIN Product p ON pv.productId = p.productId
        JOIN Shop s ON p.shopId = s.shopId
        WHERE p.name LIKE ? OR s.shopName LIKE ?
        ORDER BY pv.variantId
        """;

        try (Connection conn = DBContext.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, "%" + keyword + "%");
            ps.setString(2, "%" + keyword + "%");

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                ProductVariant pv = new ProductVariant();

                pv.setVariantId(rs.getInt("variantId"));
                pv.setSize(rs.getString("size"));
                pv.setColor(rs.getString("color"));
                pv.setStock(rs.getInt("stock"));
                pv.setPriceVariant(rs.getDouble("priceVariant"));

                Product p = new Product();
                p.setProductId(rs.getInt("productId"));
                p.setName(rs.getString("productName"));

                Shop s = new Shop();
                s.setShopName(rs.getString("shopName"));
                p.setShop(s);

                pv.setProduct(p);

                list.add(pv);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    public List<ProductVariant> searchVariant(String keyword, int page, int pageSize) {
        List<ProductVariant> list = new ArrayList<>();

        String sql = """
        SELECT pv.*, p.name AS productName, s.shopName, p.productId
        FROM ProductVariant pv
        JOIN Product p ON pv.productId = p.productId
        JOIN Shop s ON p.shopId = s.shopId
        WHERE p.name LIKE ? OR s.shopName LIKE ?
        ORDER BY pv.variantId
        OFFSET ? ROWS FETCH NEXT ? ROWS ONLY
        """;

        try (Connection con = DBContext.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, "%" + keyword + "%");
            ps.setString(2, "%" + keyword + "%");
            ps.setInt(3, (page - 1) * pageSize);
            ps.setInt(4, pageSize);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                ProductVariant pv = new ProductVariant();

                pv.setVariantId(rs.getInt("variantId"));
                pv.setSize(rs.getString("size"));
                pv.setColor(rs.getString("color"));
                pv.setStock(rs.getInt("stock"));
                pv.setPriceVariant(rs.getDouble("priceVariant"));

                Product p = new Product();
                p.setProductId(rs.getInt("productId"));
                p.setName(rs.getString("productName"));

                Shop s = new Shop();
                s.setShopName(rs.getString("shopName"));

                p.setShop(s);
                pv.setProduct(p);

                list.add(pv);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    public int countByProductId(int productId) {
        String sql = """
        SELECT COUNT(*)
        FROM ProductVariant
        WHERE productId = ?
        """;

        try (Connection con = DBContext.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setInt(1, productId);
            ResultSet rs = ps.executeQuery();

            if (rs.next()) {
                return rs.getInt(1);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return 0;
    }

    public List<ProductVariant> getByProductIdPaging(int productId, int page, int pageSize) {
        List<ProductVariant> list = new ArrayList<>();

        String sql = """
        SELECT pv.*, p.name AS productName, p.productId
        FROM ProductVariant pv
        JOIN Product p ON pv.productId = p.productId
        WHERE pv.productId = ?
        ORDER BY pv.variantId
        OFFSET ? ROWS FETCH NEXT ? ROWS ONLY
        """;

        try (Connection con = DBContext.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setInt(1, productId);
            ps.setInt(2, (page - 1) * pageSize);
            ps.setInt(3, pageSize);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                ProductVariant v = new ProductVariant();

                v.setVariantId(rs.getInt("variantId"));
                v.setSize(rs.getString("size"));
                v.setColor(rs.getString("color"));
                v.setStock(rs.getInt("stock"));
                v.setPriceVariant(rs.getDouble("priceVariant"));

                Product p = new Product();
                p.setProductId(rs.getInt("productId"));
                p.setName(rs.getString("productName"));

                v.setProduct(p);

                list.add(v);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    public List<ProductVariant> getVariants(int page, int pageSize, String shop) {
        List<ProductVariant> list = new ArrayList<>();
        int offset = (page - 1) * pageSize;

        String sql = """
        SELECT pv.variantId, pv.size, pv.color, pv.stock, pv.priceVariant,
               p.name AS productName, s.shopName, p.productId
        FROM ProductVariant pv
        JOIN Product p ON pv.productId = p.productId
        JOIN Shop s ON p.shopId = s.shopId
        WHERE s.shopName LIKE ?
        ORDER BY pv.variantId
        OFFSET ? ROWS FETCH NEXT ? ROWS ONLY
        """;

        try (Connection con = DBContext.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            if (shop == null) {
                shop = "";
            }

            ps.setString(1, "%" + shop + "%");
            ps.setInt(2, offset);
            ps.setInt(3, pageSize);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                ProductVariant v = new ProductVariant();

                v.setVariantId(rs.getInt("variantId"));
                v.setSize(rs.getString("size"));
                v.setColor(rs.getString("color"));
                v.setStock(rs.getInt("stock"));
                v.setPriceVariant(rs.getDouble("priceVariant"));

                Product p = new Product();
                p.setProductId(rs.getInt("productId"));
                p.setName(rs.getString("productName"));

                Shop s = new Shop();
                s.setShopName(rs.getString("shopName"));

                p.setShop(s);
                v.setProduct(p);

                list.add(v);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    public void insert(ProductVariant v) {
        String sql = """
        INSERT INTO ProductVariant(size, color, stock, priceVariant, productId)
        VALUES(?,?,?,?,?)
        """;

        try (Connection con = DBContext.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, v.getSize());
            ps.setString(2, v.getColor());
            ps.setInt(3, v.getStock());
            ps.setDouble(4, v.getPriceVariant());
            ps.setInt(5, v.getProduct().getProductId());

            ps.executeUpdate();

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public ProductVariant getById(int id) {
        String sql = """
        SELECT pv.*, p.name AS productName
        FROM ProductVariant pv
        JOIN Product p ON pv.productId = p.productId
        WHERE pv.variantId = ?
        """;

        try (Connection con = DBContext.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setInt(1, id);

            ResultSet rs = ps.executeQuery();

            if (rs.next()) {
                ProductVariant v = new ProductVariant();

                v.setVariantId(rs.getInt("variantId"));
                v.setSize(rs.getString("size"));
                v.setColor(rs.getString("color"));
                v.setStock(rs.getInt("stock"));
                v.setPriceVariant(rs.getDouble("priceVariant"));

                Product p = new Product();
                p.setProductId(rs.getInt("productId"));
                p.setName(rs.getString("productName"));

                v.setProduct(p);

                return v;
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return null;
    }

    public List<ProductVariant> getByProductId(int productId) {
        List<ProductVariant> list = new ArrayList<>();

        String sql = """
        SELECT pv.*, p.name AS productName
        FROM ProductVariant pv
        JOIN Product p ON pv.productId = p.productId
        WHERE pv.productId = ?
        """;

        try (Connection con = DBContext.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setInt(1, productId);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                ProductVariant v = new ProductVariant();

                v.setVariantId(rs.getInt("variantId"));
                v.setSize(rs.getString("size"));
                v.setColor(rs.getString("color"));
                v.setStock(rs.getInt("stock"));
                v.setPriceVariant(rs.getDouble("priceVariant"));

                Product p = new Product();
                p.setProductId(productId);
                p.setName(rs.getString("productName"));

                v.setProduct(p);

                list.add(v);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    public void update(ProductVariant v) {
        String sql = """
        UPDATE ProductVariant
        SET size = ?, color = ?, stock = ?, priceVariant = ?, productId = ?
        WHERE variantId = ?
        """;

        try (Connection con = DBContext.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, v.getSize());
            ps.setString(2, v.getColor());
            ps.setInt(3, v.getStock());
            ps.setDouble(4, v.getPriceVariant());
            ps.setInt(5, v.getProduct().getProductId());
            ps.setInt(6, v.getVariantId());

            ps.executeUpdate();

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public void delete(int id) {
        String sql = "DELETE FROM ProductVariant WHERE variantId = ?";

        try (Connection con = DBContext.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setInt(1, id);
            ps.executeUpdate();

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public void decreaseStock(int variantId, int quantity) throws Exception {
        String sql = """
        UPDATE ProductVariant
        SET stock = stock - ?
        WHERE variantId = ?
        """;

        try (Connection conn = DBContext.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, quantity);
            ps.setInt(2, variantId);
            ps.executeUpdate();
        }
    }

    public int decreaseStock(Connection conn, int variantId, int quantity) throws Exception {
        String sql = """
        UPDATE ProductVariant
        SET stock = stock - ?
        WHERE variantId = ? AND stock >= ?
        """;

        try (PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setInt(1, quantity);
            ps.setInt(2, variantId);
            ps.setInt(3, quantity);
            return ps.executeUpdate();
        }
    }
