            ps.setDouble(4, o.getSubtotalAmount());
            ps.setDouble(5, o.getTotalDiscount());
            ps.setDouble(6, o.getTotalAmount());
            ps.executeUpdate();

            try (ResultSet rs = ps.getGeneratedKeys()) {
                if (rs.next()) {
                    return rs.getInt(1);
                }
            }
        }

        return -1;
    }
