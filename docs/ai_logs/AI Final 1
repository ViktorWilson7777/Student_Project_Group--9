<script>
const allVoucherCards = Array.from(document.querySelectorAll(".voucher-item"));
const voucherListBox = document.getElementById("voucherList");
const voucherSearchInput = document.getElementById("voucherSearchInput");

let filteredVoucherCards = [...allVoucherCards];
let voucherVisibleCount = 8;

function getCheckedItemIds() {
    return Array.from(document.querySelectorAll(".item-checkbox:checked"))
        .map(cb => cb.value);
}

function syncHiddenSelectedInputs() {
    const checkedIds = getCheckedItemIds();

    const checkoutBox = document.getElementById("checkoutSelectedInputs");
    if (checkoutBox) {
        checkoutBox.innerHTML = "";
        checkedIds.forEach(id => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "selectedItems";
            input.value = id;
            checkoutBox.appendChild(input);
        });
    }

    const applyBox = document.getElementById("applyVoucherSelectedInputs");
    if (applyBox) {
        applyBox.innerHTML = "";
        checkedIds.forEach(id => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "selectedItems";
            input.value = id;
            applyBox.appendChild(input);
        });
    }
}

function validateCheckoutSelection() {
    const checkedIds = getCheckedItemIds();
    if (checkedIds.length === 0) {
        alert("Please tick at least one product before checkout.");
        return false;
    }
    syncHiddenSelectedInputs();
    return true;
}

function updateSelectedByReload() {
    const checkedIds = getCheckedItemIds();
    const url = new URL(window.location.href);
    url.searchParams.delete("selectedItems");
    checkedIds.forEach(id => url.searchParams.append("selectedItems", id));
    window.location.href = url.toString();
}

document.querySelectorAll(".item-checkbox").forEach(cb => {
    cb.addEventListener("change", function () {
        updateSelectedByReload();
    });
});

function applyVoucherSearch() {
    const keyword = (voucherSearchInput.value || "").trim().toLowerCase();

    filteredVoucherCards = allVoucherCards.filter(card => {
        const code = (card.getAttribute("data-code") || "").toLowerCase();
        return keyword === "" || code.includes(keyword);
    });

    voucherVisibleCount = 8;
    renderVoucherList();
}

function renderVoucherList() {
    if (!voucherListBox) return;

    allVoucherCards.forEach(card => card.style.display = "none");

    if (filteredVoucherCards.length === 0) {
        document.getElementById("voucherEmptyText").style.display = "block";
        return;
    } else {
        document.getElementById("voucherEmptyText").style.display = "none";
    }

    filteredVoucherCards.slice(0, voucherVisibleCount).forEach(card => {
        card.style.display = "block";
    });
}

if (voucherSearchInput) {
    voucherSearchInput.addEventListener("input", applyVoucherSearch);
}

if (voucherListBox) {
    voucherListBox.addEventListener("scroll", function () {
        if (voucherListBox.scrollTop + voucherListBox.clientHeight >= voucherListBox.scrollHeight - 10) {
            if (voucherVisibleCount < filteredVoucherCards.length) {
                voucherVisibleCount += 8;
                renderVoucherList();
            }
        }
    });
}

document.addEventListener("DOMContentLoaded", function () {
    syncHiddenSelectedInputs();
    renderVoucherList();
});
</script>
