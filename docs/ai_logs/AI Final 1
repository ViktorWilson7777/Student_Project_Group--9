<script>
const ITEM_STORAGE_KEY = "cart_selected_items";
const MAX_VISIBLE_VOUCHERS = 8;

function openVoucherModal() {
    document.getElementById("voucherModal").style.display = "block";
    handleVoucherSelection();
    applyVoucherSearch();
}

function closeVoucherModal() {
    document.getElementById("voucherModal").style.display = "none";
}

function getCheckedItemIds() {
    return Array.from(document.querySelectorAll(".itemCheck:checked"))
        .map(cb => cb.value);
}

function saveCheckedItems() {
    sessionStorage.setItem(ITEM_STORAGE_KEY, JSON.stringify(getCheckedItemIds()));
}

function restoreCheckedItems() {
    const saved = sessionStorage.getItem(ITEM_STORAGE_KEY);
    if (!saved) return;

    try {
        const ids = JSON.parse(saved);
        document.querySelectorAll(".itemCheck").forEach(cb => {
            cb.checked = ids.includes(cb.value);
        });
    } catch (e) {
        console.log(e);
    }
}

function syncHiddenSelectedInputs() {
    const checkedIds = getCheckedItemIds();

    const checkoutBox = document.getElementById("checkoutSelectedInputs");
    if (checkoutBox) {
        checkoutBox.innerHTML = "";
        checkedIds.forEach(id => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "selectedItems";
            input.value = id;
            checkoutBox.appendChild(input);
        });
    }

    const voucherBox = document.getElementById("voucherSelectedItemInputs");
    if (voucherBox) {
        voucherBox.innerHTML = "";
        checkedIds.forEach(id => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "selectedItems";
            input.value = id;
            voucherBox.appendChild(input);
        });
    }
}

function updateSelectedItemsOnServer() {
    saveCheckedItems();
    syncHiddenSelectedInputs();

    const checkedIds = getCheckedItemIds();
    const url = new URL(window.location.href);
    url.searchParams.delete("selectedItems");

    checkedIds.forEach(id => url.searchParams.append("selectedItems", id));

    window.location.href = url.toString();
}

function validateCheckoutSelection() {
    const checkedIds = getCheckedItemIds();

    if (checkedIds.length === 0) {
        alert("Please tick at least one product before checkout.");
        return false;
    }

    saveCheckedItems();
    syncHiddenSelectedInputs();
    return true;
}

function prepareVoucherSubmit() {
    const checkedIds = getCheckedItemIds();

    if (checkedIds.length === 0) {
        alert("Please tick product(s) before applying voucher.");
        return false;
    }

    const checkedVoucherCount = document.querySelectorAll(".voucher-checkbox:checked").length;
    if (checkedVoucherCount > 3) {
        alert("You can apply at most 3 vouchers only.");
        return false;
    }

    saveCheckedItems();
    syncHiddenSelectedInputs();
    return true;
}

const checkAll = document.getElementById("checkAll");
if (checkAll) {
    checkAll.addEventListener("change", function () {
        let items = document.querySelectorAll(".itemCheck");
        items.forEach(function (cb) {
            cb.checked = checkAll.checked;
        });
        updateSelectedItemsOnServer();
    });
}

document.querySelectorAll(".itemCheck").forEach(cb => {
    cb.addEventListener("change", function () {
        updateSelectedItemsOnServer();
    });
});

function handleVoucherSelection() {
    let checkboxes = document.querySelectorAll(".voucher-checkbox");

    let selected = [];
    checkboxes.forEach(cb => {
        if (cb.checked) {
            selected.push(cb);
        }
    });

    let stackSelected = selected.filter(cb => cb.dataset.type === "STACK");
    let nonStackSelected = selected.filter(cb => cb.dataset.type === "NON_STACK");

    checkboxes.forEach(cb => {
        cb.disabled = false;
        cb.parentElement.classList.remove("voucher-disabled");
    });

    if (nonStackSelected.length > 0) {
        checkboxes.forEach(cb => {
            if (!cb.checked) {
                cb.disabled = true;
                cb.parentElement.classList.add("voucher-disabled");
            }
        });
        return;
    }

    if (stackSelected.length > 0) {
        checkboxes.forEach(cb => {
            if (cb.dataset.type === "NON_STACK") {
                cb.disabled = true;
                cb.parentElement.classList.add("voucher-disabled");
            }
        });

        if (stackSelected.length >= 3) {
            checkboxes.forEach(cb => {
                if (!cb.checked) {
                    cb.disabled = true;
                    cb.parentElement.classList.add("voucher-disabled");
                }
            });
        }
    }
}

let allVoucherItems = [];
let filteredVoucherItems = [];
let visibleVoucherCount = MAX_VISIBLE_VOUCHERS;

function applyVoucherSearch() {
    const keyword = document.getElementById("searchVoucher").value.toLowerCase().trim();

    filteredVoucherItems = allVoucherItems.filter(item => {
        const code = item.getAttribute("data-code").toLowerCase();
        return keyword === "" || code.includes(keyword);
    });

    visibleVoucherCount = MAX_VISIBLE_VOUCHERS;
    renderVoucherItems();
}

function renderVoucherItems() {
    const emptyText = document.getElementById("voucherEmptyText");

    allVoucherItems.forEach(item => {
        item.style.display = "none";
    });

    if (filteredVoucherItems.length === 0) {
        if (emptyText) emptyText.style.display = "block";
        return;
    } else {
        if (emptyText) emptyText.style.display = "none";
    }

    filteredVoucherItems.slice(0, visibleVoucherCount).forEach(item => {
        item.style.display = "block";
    });

    handleVoucherSelection();
}

document.addEventListener("DOMContentLoaded", function () {
    restoreCheckedItems();
    syncHiddenSelectedInputs();

    allVoucherItems = Array.from(document.querySelectorAll(".voucher-item"));
    filteredVoucherItems = [...allVoucherItems];

    const selected = "${param.selectedVariantIds}";
    if (selected) {
        selected.split(",").forEach(function(id){
            const checkbox = document.querySelector('input[name="selectedItems"][value="' + id + '"]');
            if (checkbox) {
                checkbox.checked = true;
            }
        });
        saveCheckedItems();
        syncHiddenSelectedInputs();
    }

    const searchInput = document.getElementById("searchVoucher");
    if (searchInput) {
        searchInput.addEventListener("input", applyVoucherSearch);
    }

    const voucherListBox = document.getElementById("voucherListBox");
    if (voucherListBox) {
        voucherListBox.addEventListener("scroll", function () {
            if (voucherListBox.scrollTop + voucherListBox.clientHeight >= voucherListBox.scrollHeight - 10) {
                if (visibleVoucherCount < filteredVoucherItems.length) {
                    visibleVoucherCount += MAX_VISIBLE_VOUCHERS;
                    renderVoucherItems();
                }
            }
        });
    }

    renderVoucherItems();
});
</script>
