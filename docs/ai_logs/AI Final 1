public List<Map<String, Object>> getOrdersByUser(int userId, String status) {
    List<Map<String, Object>> orders = new ArrayList<>();

    boolean filterStatus = status != null
            && !status.trim().isEmpty()
            && !"ALL".equalsIgnoreCase(status);

    String sql;
    if (filterStatus) {
        sql = """
            SELECT orderId, userId, orderDate, status, subtotalAmount, totalDiscount, totalAmount
            FROM [Order]
            WHERE userId = ? AND status = ?
            ORDER BY orderDate DESC, orderId DESC
        """;
    } else {
        sql = """
            SELECT orderId, userId, orderDate, status, subtotalAmount, totalDiscount, totalAmount
            FROM [Order]
            WHERE userId = ?
            ORDER BY orderDate DESC, orderId DESC
        """;
    }

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql)) {

        ps.setInt(1, userId);
        if (filterStatus) {
            ps.setString(2, status.trim().toUpperCase());
        }

        try (ResultSet rs = ps.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> order = new LinkedHashMap<>();

                int orderId = rs.getInt("orderId");

                order.put("orderId", orderId);
                order.put("userId", rs.getInt("userId"));
                order.put("orderDate", rs.getTimestamp("orderDate"));
                order.put("status", rs.getString("status"));
                order.put("subtotalAmount", rs.getDouble("subtotalAmount"));
                order.put("totalDiscount", rs.getDouble("totalDiscount"));
                order.put("totalAmount", rs.getDouble("totalAmount"));
                order.put("items", getOrderItems(conn, orderId));

                orders.add(order);
            }
        }

    } catch (Exception e) {
        e.printStackTrace();
    }

    return orders;
}

private List<Map<String, Object>> getOrderItems(Connection conn, int orderId) throws Exception {
    List<Map<String, Object>> items = new ArrayList<>();

    String sql = """
        SELECT oi.quantity,
               p.name AS productName,
               p.imageUrl,
               pv.color,
               pv.size
        FROM OrderItem oi
        JOIN ProductVariant pv ON oi.variantId = pv.variantId
        JOIN Product p ON pv.productId = p.productId
        WHERE oi.orderId = ?
        ORDER BY oi.orderItemId
    """;

    try (PreparedStatement ps = conn.prepareStatement(sql)) {
        ps.setInt(1, orderId);

        try (ResultSet rs = ps.executeQuery()) {
            while (rs.next()) {
                Map<String, Object> item = new LinkedHashMap<>();

                item.put("productName", rs.getString("productName"));
                item.put("imageUrl", rs.getString("imageUrl"));
                item.put("color", rs.getString("color"));
                item.put("size", rs.getString("size"));
                item.put("quantity", rs.getInt("quantity"));

                items.add(item);
            }
        }
    }

    return items;
}
