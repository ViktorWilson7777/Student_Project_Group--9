package dal;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;
import model.Order;
import model.OrderStatus;

public class OrderDAO extends DBContext {

    public int insert(Order o) throws Exception {
        try (Connection conn = DBContext.getConnection()) {
            return insert(conn, o);
        }
    }

    public int insert(Connection conn, Order o) throws Exception {
        String sql = """
        INSERT INTO [Order](userId, orderDate, status,
        subtotalAmount, totalDiscount, totalAmount)
        VALUES (?,?,?,?,?,?)
        """;

        try (PreparedStatement ps = conn.prepareStatement(sql, Statement.RETURN_GENERATED_KEYS)) {
            ps.setInt(1, o.getUserId());
            ps.setTimestamp(2, new Timestamp(o.getOrderDate().getTime()));
            ps.setString(3, o.getStatus().name());
            ps.setDouble(4, o.getSubtotalAmount());
            ps.setDouble(5, o.getTotalDiscount());
            ps.setDouble(6, o.getTotalAmount());
            ps.executeUpdate();

            try (ResultSet rs = ps.getGeneratedKeys()) {
                if (rs.next()) {
                    return rs.getInt(1);
                }
            }
        }

        return -1;
    }

    public void autoUpdateStatuses() {
        try (Connection conn = DBContext.getConnection()) {

            String sqlToShip = """
            UPDATE [Order]
            SET status = 'PAID'
            WHERE status = 'CREATED'
              AND DATEDIFF(DAY, orderDate, GETDATE()) >= 1
            """;

            try (PreparedStatement ps = conn.prepareStatement(sqlToShip)) {
                ps.executeUpdate();
            }

            String sqlCompleted = """
            UPDATE [Order]
            SET status = 'COMPLETED'
            WHERE status = 'PAID'
              AND DATEDIFF(DAY, orderDate, GETDATE()) >= 3
            """;

            try (PreparedStatement ps = conn.prepareStatement(sqlCompleted)) {
                ps.executeUpdate();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public List<Order> getOrdersByUser(int userId, String status) {
        List<Order> list = new ArrayList<>();

        boolean filterStatus = status != null
                && !status.trim().isEmpty()
                && !"ALL".equalsIgnoreCase(status);

        String sql;
        if (filterStatus) {
            sql = """
            SELECT *
            FROM [Order]
            WHERE userId = ? AND status = ?
            ORDER BY orderDate DESC, orderId DESC
            """;
        } else {
            sql = """
            SELECT *
            FROM [Order]
            WHERE userId = ?
            ORDER BY orderDate DESC, orderId DESC
            """;
        }

        try (Connection conn = DBContext.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, userId);

            if (filterStatus) {
                ps.setString(2, status.trim().toUpperCase());
            }

            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    Order o = new Order();
                    o.setOrderId(rs.getInt("orderId"));
                    o.setUserId(rs.getInt("userId"));
                    o.setOrderDate(rs.getTimestamp("orderDate"));

                    String dbStatus = rs.getString("status");
                    if (dbStatus != null) {
                        o.setStatus(OrderStatus.valueOf(dbStatus.toUpperCase()));
                    }

                    o.setSubtotalAmount(rs.getDouble("subtotalAmount"));
                    o.setTotalDiscount(rs.getDouble("totalDiscount"));
                    o.setTotalAmount(rs.getDouble("totalAmount"));

                    list.add(o);
                }
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }
}
