package dal;

import java.util.*;
import model.*;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

public class ShopDAO extends DBContext {

    public List<Shop> searchShop(String keyword, int page){

    List<Shop> list = new ArrayList<>();

    int pageSize = 20;

    String sql = """
        SELECT s.shopId, s.shopName, u.name
        FROM Shop s
        JOIN AppUser u ON s.ownerId = u.userId
        WHERE s.shopName LIKE ?
        ORDER BY s.shopId
        OFFSET ? ROWS FETCH NEXT ? ROWS ONLY
    """;

    try(Connection conn = DBContext.getConnection();
        PreparedStatement ps = conn.prepareStatement(sql)){

        ps.setString(1, "%" + keyword + "%");
        ps.setInt(2, (page-1)*pageSize);
        ps.setInt(3, pageSize);

        ResultSet rs = ps.executeQuery();

        while(rs.next()){

            Shop s = new Shop();
            s.setShopId(rs.getInt(1));
            s.setShopName(rs.getString(2));

            AppUser u = new AppUser();
            u.setName(rs.getString(3));

            s.setOwner(u);

            list.add(s);
        }

    }catch(Exception e){
        e.printStackTrace();
    }

    return list;
}

    public Shop getByShopId(int id) {

        String sql = """
        SELECT s.shopId,
               s.shopName,
               s.ownerId,
               u.name AS ownerName
        FROM Shop s
        JOIN AppUser u ON s.ownerId = u.userId
        WHERE s.shopId = ?
    """;

        try (Connection conn = DBContext.getConnection(); PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, id);

            try (ResultSet rs = ps.executeQuery()) {

                if (rs.next()) {
                    Shop s = new Shop();
                    s.setShopId(rs.getInt("shopId"));
                    s.setShopName(rs.getString("shopName"));

                    AppUser owner = new AppUser();
                    owner.setUserId(rs.getInt("ownerId"));
                    owner.setName(rs.getString("ownerName"));

                    s.setOwner(owner);

                    return s;
                }
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return null;
    }

    public List<Shop> getAll() throws Exception {

        List<Shop> list = new ArrayList<>();

        String sql = """
    SELECT s.shopId,
           s.shopName,
           s.ownerId,
           u.name AS ownerName
    FROM Shop s
    JOIN AppUser u ON s.ownerId = u.userId
""";

        try (Connection conn = DBContext.getConnection(); PreparedStatement ps = conn.prepareStatement(sql); ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                Shop s = new Shop();

                s.setShopId(rs.getInt("shopId"));
                s.setShopName(rs.getString("shopName"));

                AppUser owner = new AppUser();
                owner.setUserId(rs.getInt("ownerId"));
                owner.setName(rs.getString("ownerName"));

                s.setOwner(owner);

                list.add(s);
            }
        }

        return list;
    }

    public Shop getByOwnerId(int ownerId) {
        String sql = "SELECT * FROM Shop WHERE ownerId = ?";
        try (Connection conn = DBContext.getConnection(); PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, ownerId);
            ResultSet rs = ps.executeQuery();

            if (rs.next()) {
                AppUser owner = new AppUser();
                owner.setUserId(rs.getInt("ownerId"));

                Shop shop = new Shop();
                shop.setShopId(rs.getInt("shopId"));
                shop.setShopName(rs.getString("shopName"));
                shop.setOwner(owner);

                return shop;
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        return null;
    }

    public void insert(String name, int ownerId) {
        String sql = "INSERT INTO Shop(shopName, ownerId) VALUES (?, ?)";

        try (Connection conn = DBContext.getConnection(); PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, name);
            ps.setInt(2, ownerId);
            ps.executeUpdate();

        } catch (Exception e) {
        }
    }

    public void delete(int id) {
        String sql = "DELETE FROM Shop WHERE shopId = ?";

        try (Connection conn = DBContext.getConnection(); PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, id);
            ps.executeUpdate();

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public void update(Shop shop) {

        String sql = "UPDATE Shop SET shopName = ?, ownerId = ? WHERE shopId = ?";

        try (Connection conn = DBContext.getConnection(); PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, shop.getShopName());
            ps.setInt(2, shop.getOwner().getUserId());
            ps.setInt(3, shop.getShopId());

            ps.executeUpdate();

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

}

