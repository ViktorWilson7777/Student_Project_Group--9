Product.java
public class Product {
    private int productId;
    private String name;
    private double price;
    private String imageUrl;

    public String getImageUrl() {
        if (imageUrl != null && !imageUrl.trim().isEmpty()) {
            return imageUrl;
        }

        String n = name == null ? "" : name.toLowerCase();

        if (n.contains("jacket")) return "images/products/jacket.jpg";
        if (n.contains("cap")) return "images/products/cap.jpg";
        if (n.contains("handbag")) return "images/products/handbag.jpg";
        if (n.contains("jeans")) return "images/products/jeans.jpg";
        if (n.contains("backpack")) return "images/products/backpack.jpg";

        return "images/products/default.jpg";
    }

    public void setImageUrl(String imageUrl) {
        this.imageUrl = imageUrl;
    }

    public String getName() {
        return name;
    }
}
