Ví dụ:

public List<Product> getRandomProductsForHome() {
    List<Product> list = new ArrayList<>();
    String sql =
        "WITH RankedProducts AS ( " +
        "    SELECT p.productId, p.shopId, p.name, p.price, p.imageUrl, " +
        "           ROW_NUMBER() OVER (PARTITION BY p.name ORDER BY NEWID()) AS rn " +
        "    FROM Product p " +
        "), " +
        "UniqueProducts AS ( " +
        "    SELECT rp.productId, rp.shopId, rp.name, rp.price, rp.imageUrl " +
        "    FROM RankedProducts rp " +
        "    WHERE rp.rn = 1 " +
        ") " +
        "SELECT TOP 20 up.productId, up.shopId, up.name, up.price, up.imageUrl, s.shopName " +
        "FROM UniqueProducts up " +
        "JOIN Shop s ON s.shopId = up.shopId " +
        "ORDER BY NEWID()";

    try {
        PreparedStatement ps = connection.prepareStatement(sql);
        ResultSet rs = ps.executeQuery();

        while (rs.next()) {
            Product p = new Product();
            p.setProductId(rs.getInt("productId"));
            p.setName(rs.getString("name"));
            p.setPrice(rs.getDouble("price"));
            p.setImageUrl(rs.getString("imageUrl"));

            Shop s = new Shop();
            s.setShopId(rs.getInt("shopId"));
            s.setShopName(rs.getString("shopName"));
            p.setShop(s);

            list.add(p);
        }
    } catch (Exception e) {
        e.printStackTrace();
    }
    return list;
}
