addToCart()
function addToCart() {
    let qty = document.getElementById("quantity").value;
    let variant = null;

    if (variants.length === 1) {
        variant = variants[0];
    } else {
        variant = variants.find(v =>
            v.size === selectedSize &&
            v.color === selectedColor
        );
    }

    if (!variant) {
        alert("Please select size and color");
        return;
    }

    window.location =
        "add-to-cart?variantId=" + variant.id + "&qty=" + qty;
}
