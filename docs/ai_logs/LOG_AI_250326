WITH RankedProducts AS (
    SELECT 
        p.productId,
        p.shopId,
        p.name,
        p.price,
        p.imageUrl,
        CASE 
            WHEN p.productId >= (SELECT MAX(productId) - 2000 FROM Product) THEN 1
            ELSE 0
        END AS isNewGroup,
        ROW_NUMBER() OVER (
            PARTITION BY p.name
            ORDER BY NEWID()
        ) AS rn
    FROM Product p
),
UniqueProducts AS (
    SELECT *
    FROM RankedProducts
    WHERE rn = 1
),
MixedProducts AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY isNewGroup ORDER BY NEWID()) AS mix_order
    FROM UniqueProducts
)
SELECT TOP 20
    productId,
    shopId,
    name,
    price,
    imageUrl
FROM MixedProducts
ORDER BY mix_order, isNewGroup DESC;
