public String getAutoImage() {
    String n = name.toLowerCase();

    if (n.contains("jacket") && n.contains("adidas")) return "images/products/jacket_adidas.jpg";
    if (n.contains("jacket") && n.contains("puma")) return "images/products/jacket_puma.jpg";
    if (n.contains("cap") && n.contains("gucci")) return "images/products/cap_gucci.jpg";
    if (n.contains("handbag") && n.contains("gucci")) return "images/products/handbag_gucci.jpg";
    if (n.contains("jeans") && n.contains("uniqlo")) return "images/products/jeans_uniqlo.jpg";
    if (n.contains("backpack") && n.contains("adidas")) return "images/products/backpack_adidas.jpg";

    if (n.contains("jacket")) return "images/products/jacket.jpg";
    if (n.contains("cap")) return "images/products/cap.jpg";
    if (n.contains("handbag")) return "images/products/handbag.jpg";
    if (n.contains("jeans")) return "images/products/jeans.jpg";
    if (n.contains("backpack")) return "images/products/backpack.jpg";

    return "images/products/default.jpg";
}
