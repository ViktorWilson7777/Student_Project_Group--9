🎯 7️⃣ JavaScript Infinite Scroll
<script>
let page = 1;
let loading = false;
let shopSearch = "";

function loadData() {
    if (loading) return;
    loading = true;

    fetch(`loadVariants?page=${page}&shop=${shopSearch}`)
        .then(res => res.text())
        .then(data => {
            document.getElementById("variantTable")
                    .insertAdjacentHTML("beforeend", data);
            page++;
            loading = false;
        });
}

function search() {
    shopSearch = document.getElementById("searchShop").value;
    page = 1;
    document.getElementById("variantTable").innerHTML = "";
    loadData();
}

window.onload = function() {
    loadData();
}

window.onscroll = function() {
    if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 50) {
        loadData();
    }
}
</script>
