3️⃣ Quan trọng nhất: logic chọn Size + Color
Bạn cần list ProductVariant:

Controller đã gửi:

variants
Mỗi variant:

size
color
stock
price
JS xử lý chọn variant
Thêm dưới JSP:

<script>

let variants = [
<c:forEach var="v" items="${variants}">
{
size:"${v.size}",
color:"${v.color}",
stock:${v.stock},
id:${v.id}
},
</c:forEach>
];

let selectedSize = null;
let selectedColor = null;

function updateOptions(){

document.querySelectorAll(".color-btn").forEach(btn=>{

let color = btn.dataset.color;

let valid = variants.some(v =>
v.color==color &&
(selectedSize==null || v.size==selectedSize)
);

btn.classList.toggle("disabled",!valid);

});

document.querySelectorAll(".size-btn").forEach(btn=>{

let size = btn.dataset.size;

let valid = variants.some(v =>
v.size==size &&
(selectedColor==null || v.color==selectedColor)
);

btn.classList.toggle("disabled",!valid);

});

updateStock();
}

function updateStock(){

let v = variants.find(v =>
v.size==selectedSize &&
v.color==selectedColor
);

if(v){
document.getElementById("stock").innerText = v.stock;
}else{
document.getElementById("stock").innerText = "";
}

}

document.querySelectorAll(".size-btn").forEach(btn=>{
btn.onclick = function(){

if(btn.classList.contains("disabled")) return;

selectedSize = btn.dataset.size;

document.querySelectorAll(".size-btn").forEach(b=>b.classList.remove("selected"));
btn.classList.add("selected");

updateOptions();
};
});

document.querySelectorAll(".color-btn").forEach(btn=>{
btn.onclick = function(){

if(btn.classList.contains("disabled")) return;

selectedColor = btn.dataset.color;

document.querySelectorAll(".color-btn").forEach(b=>b.classList.remove("selected"));
btn.classList.add("selected");

updateOptions();
};
});

updateOptions();

</script>
