package controller;

import dal.ProductDAO;
import dal.ProductVariantDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;
import java.io.IOException;
import java.util.List;
import model.AppUser;
import model.Product;
import model.ProductVariant;

@WebServlet("/user-home")
public class UserHomeController extends HttpServlet {

    ProductDAO productDAO = new ProductDAO();
    ProductVariantDAO variantDAO = new ProductVariantDAO();

    @Override
    protected void doGet(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        HttpSession session = request.getSession(false);

        if (session == null || session.getAttribute("account") == null) {
            response.sendRedirect("login.jsp");
            return;
        }

        AppUser user = (AppUser) session.getAttribute("account");

        if ("admin".equalsIgnoreCase(user.getRole())) {
            response.sendRedirect("home");
            return;
        }

        // kiểm tra productId
        String productIdParam = request.getParameter("productId");

        if (productIdParam != null) {

            int productId = Integer.parseInt(productIdParam);

            Product product = productDAO.getProductById(productId);
            List<ProductVariant> variants = variantDAO.getVariantsByProductId(productId);

            request.setAttribute("productDetail", product);
            request.setAttribute("variants", variants);

        } else {

            String productKeyword = request.getParameter("productKeyword");
            String shopKeyword = request.getParameter("shopKeyword");

            if (productKeyword == null) productKeyword = "";
            if (shopKeyword == null) shopKeyword = "";

            int page = 1;
            int pageSize = 20;

            String pageParam = request.getParameter("page");
            if (pageParam != null) {
                page = Integer.parseInt(pageParam);
            }

            int offset = (page - 1) * pageSize;

            List<Product> products;

            if (productKeyword.isEmpty() && shopKeyword.isEmpty()) {
                products = productDAO.getProductPaging(offset, pageSize);
            } else {
                products = productDAO.searchProductAndShop(productKeyword, shopKeyword, offset, pageSize);
            }

            request.setAttribute("products", products);
            request.setAttribute("productKeyword", productKeyword);
            request.setAttribute("shopKeyword", shopKeyword);
        }

        request.getRequestDispatcher("user/user-home.jsp")
                .forward(request, response);
    }
}
