public int countProducts() {

    String sql = "SELECT COUNT(*) FROM Product";

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql);
         ResultSet rs = ps.executeQuery()) {

        if (rs.next()) {
            return rs.getInt(1);
        }

    } catch (Exception e) {
        e.printStackTrace();
    }

    return 0;
}
2️⃣ countSearchProduct
public int countSearchProduct(String productKeyword, String shopKeyword) {

    String sql = """
        SELECT COUNT(*)
        FROM Product p
        JOIN Shop s ON p.shopId = s.shopId
        WHERE p.name LIKE ?
        AND s.shopName LIKE ?
    """;

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql)) {

        ps.setString(1, "%" + productKeyword + "%");
        ps.setString(2, "%" + shopKeyword + "%");

        ResultSet rs = ps.executeQuery();

        if (rs.next()) {
            return rs.getInt(1);
        }

    } catch (Exception e) {
        e.printStackTrace();
    }

    return 0;
}
