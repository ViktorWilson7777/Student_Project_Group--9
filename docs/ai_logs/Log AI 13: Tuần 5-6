<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<style>
    .product-detail{
        display:flex;
        gap:40px;
    }

    .left{
        width:40%;
    }

    .main-img{
        width:100%;
    }

    .right{
        width:60%;
    }

    .color-btn,.size-btn{
        padding:8px 15px;
        margin:5px;
        border:1px solid #ccc;
        cursor:pointer;
    }

    .disabled{
        background:#eee;
        color:#999;
        cursor:not-allowed;
    }

    .selected{
        border:2px solid red;
    }

    .variant-btn{
        padding:6px 12px;
        border:1px solid #ccc;
        background:white;
        cursor:pointer;
        margin:3px;
    }

    .variant-btn.active{
        border:2px solid red;
        background:#ffecec;
    }

    .variant-btn.disabled{
        background:#eee;
        color:#aaa;
        cursor:not-allowed;
    }

    .variant-btn:hover{
        border-color:red;
    }
</style>




<div class="product-detail">

    <div class="left">
        <c:if test="${product != null}">
            <img src="images/${product.imageUrl}" class="main-img">
        </c:if>
    </div>

    <div class="right">

        <h2>${product.name}</h2>

        <div class="price">
            ${product.price} VND
        </div>

        <!-- COLOR -->
        <h4>Color</h4>
        <div id="color-list">
            <c:set var="colorList" value="" />

            <c:forEach var="v" items="${variants}">

                <c:if test="${!fn:contains(colorList, v.color)}">

                    <button 
                        class="variant-btn color-btn"
                        data-color="${v.color}"
                        onclick="selectColor('${v.color}')">

                        ${v.color}

                    </button>

                    <c:set var="colorList" value="${colorList}${v.color}," />

                </c:if>

            </c:forEach>
        </div>

        <!-- SIZE -->
        <h4>Size</h4>
        <div id="size-list">
            <c:set var="sizeList" value="" />

            <c:forEach var="v" items="${variants}">

                <c:if test="${!fn:contains(sizeList, v.size)}">

                    <button 
                        class="variant-btn size-btn"
                        data-size="${v.size}"
                        onclick="selectSize('${v.size}')">

                        ${v.size}

                    </button>

                    <c:set var="sizeList" value="${sizeList}${v.size}," />

                </c:if>

            </c:forEach>
        </div>

        <!-- STOCK -->
        <p>
            Stock: <span id="stock"></span>
        </p>
        <div style="margin-top:10px;">

            <button onclick="decreaseQty()">-</button>

            <input type="number" id="quantity" value="1" min="1" style="width:50px; text-align:center;">

            <button onclick="increaseQty()">+</button>

        </div>
        <!-- ACTION -->
        <button onclick="addToCart()">Add To Cart</button>
        <a href="cart?variantId=${pv.variantId}&quantity=1">Buy</a>

    </div>

</div>

<script>

    let variants = [

    <c:forEach var="v" items="${variants}">
        {
            size: "${v.size}",
            color: "${v.color}",
            stock: ${v.stock},
            price: ${v.priceVariant}
        },
    </c:forEach>

    ];

    let selectedColor = null;
    let selectedSize = null;

    function selectColor(color) {

        let btn = event.target;

        if (btn.classList.contains("disabled")) {
            return;
        }

        if (selectedColor === color) {
            selectedColor = null;
            btn.classList.remove("active");
        } else {
            selectedColor = color;

            document.querySelectorAll(".color-btn").forEach(b => {
                b.classList.remove("active");
            });

            btn.classList.add("active");
        }

        updateAvailable();
        updateStock();

    }

    function selectSize(size) {

        let btn = event.target;

        if (btn.classList.contains("disabled")) {
            return;
        }

        if (selectedSize === size) {
            selectedSize = null;
            btn.classList.remove("active");
        } else {
            selectedSize = size;

            document.querySelectorAll(".size-btn").forEach(b => {
                b.classList.remove("active");
            });

            btn.classList.add("active");
        }

        updateAvailable();
        updateStock();

    }

    function updateStock() {

        let variant = variants.find(v =>
            v.size === selectedSize &&
                    v.color === selectedColor
        );

        if (variant) {

            document.getElementById("stock").innerText = variant.stock;

        }

    }

    function increaseQty() {

        let qty = document.getElementById("quantity");

        qty.value = parseInt(qty.value) + 1;

    }

    function decreaseQty() {

        let qty = document.getElementById("quantity");

        if (qty.value > 1) {

            qty.value = parseInt(qty.value) - 1;

        }

    }

    function addToCart() {

        let qty = document.getElementById("quantity").value;

        let variant = variants.find(v =>
            v.size === selectedSize &&
                    v.color === selectedColor
        );

        if (!variant) {
            alert("Please select size and color");
            return;
        }

        window.location =
                "add-to-cart?variantId=" + variant.id + "&qty=" + qty;

    }

    function updateAvailable() {

        document.querySelectorAll(".color-btn").forEach(btn => {

            let color = btn.dataset.color;

            let valid = variants.some(v =>
                v.color === color &&
                        (selectedSize == null || v.size === selectedSize)
            );

            btn.classList.toggle("disabled", !valid);

        });


        document.querySelectorAll(".size-btn").forEach(btn => {

            let size = btn.dataset.size;

            let valid = variants.some(v =>
                v.size === size &&
                        (selectedColor == null || v.color === selectedColor)
            );

            btn.classList.toggle("disabled", !valid);

        });

    }
</script>

