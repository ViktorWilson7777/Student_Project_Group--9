3. Thêm hàm mới trong ProductDAO
Thêm function:

public List<Product> searchProductAndShop(String productKeyword,
                                          String shopKeyword,
                                          int offset,
                                          int limit){

    List<Product> list = new ArrayList<>();

    String sql = """
    SELECT p.productId,
           p.name,
           p.price,
           s.shopId,
           s.shopName
    FROM Product p
    JOIN Shop s ON p.shopId = s.shopId
    WHERE p.name LIKE ?
    AND s.shopName LIKE ?
    ORDER BY p.productId
    OFFSET ? ROWS FETCH NEXT ? ROWS ONLY
    """;

    try(Connection conn = DBContext.getConnection();
        PreparedStatement ps = conn.prepareStatement(sql)){

        ps.setString(1, "%" + productKeyword + "%");
        ps.setString(2, "%" + shopKeyword + "%");
        ps.setInt(3, offset);
        ps.setInt(4, limit);

        ResultSet rs = ps.executeQuery();

        while(rs.next()){

            Shop shop = new Shop();
            shop.setShopId(rs.getInt("shopId"));
            shop.setShopName(rs.getString("shopName"));

            Product p = new Product(
                    rs.getInt("productId"),
                    rs.getString("name"),
                    rs.getDouble("price"),
                    shop
            );

            list.add(p);
        }

    }catch(Exception e){
        e.printStackTrace();
    }

    return list;
}
