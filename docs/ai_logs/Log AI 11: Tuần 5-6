let selected = [];

document.querySelectorAll(".voucher").forEach(v => {

    v.onclick = function() {

        let id = this.dataset.id;
        let stack = this.dataset.stack === "true";

        if(!stack){ // NON STACK

            selected = [id];

            document.querySelectorAll(".voucher")
                .forEach(x => x.classList.add("disabled"));

            this.classList.remove("disabled");

        }else{ // STACK

            if(selected.includes(id)){
                selected = selected.filter(v => v != id);
                this.classList.remove("selected");
                return;
            }

            if(selected.length >= 3){
                alert("Max 3 vouchers");
                return;
            }

            selected.push(id);
            this.classList.add("selected");

            document.querySelectorAll(".voucher").forEach(x=>{
                if(x.dataset.stack === "false"){
                    x.classList.add("disabled");
                }
            });

        }

    }

});
