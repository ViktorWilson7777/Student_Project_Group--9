function loadMore(){

    fetch("product-list?offset=" + offset)
    .then(res => res.text())
    .then(data => {

        let parser = new DOMParser();
        let doc = parser.parseFromString(data, "text/html");

        let newRows = doc.querySelectorAll("#productTable tr");

        let table = document.getElementById("productTable");

        newRows.forEach(row => {
