package controller;

import dal.VoucherDAO;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;
import java.io.IOException;
import java.util.*;
import model.Voucher;

@WebServlet("/apply-voucher")
public class ApplyVoucherController extends HttpServlet {

    protected void doPost(HttpServletRequest request,
                          HttpServletResponse response)
            throws ServletException, IOException {

        try {

            HttpSession session = request.getSession();

            String[] ids = request.getParameterValues("voucherIds");

            if(ids == null){
                response.sendRedirect("cart");
                return;
            }

            VoucherDAO dao = new VoucherDAO();

            List<Voucher> selected = new ArrayList<>();

            for(String id : ids){

                Voucher v = dao.getById(Integer.parseInt(id));

                selected.add(v);
            }

            double total = (double) session.getAttribute("cartTotal");

            double discountPercent = 0;

            double maxMinOrder = 0;

            for(Voucher v : selected){

                if(total < v.getMinOrderAmount()){
                    request.setAttribute("error",
                    "Cart chưa đủ điều kiện voucher " + v.getCode());
                    request.getRequestDispatcher("cart").forward(request,response);
                    return;
                }

                discountPercent += v.getDiscountPercent();

                if(v.getMinOrderAmount() > maxMinOrder){
                    maxMinOrder = v.getMinOrderAmount();
                }
            }

            double finalPrice = total * (1 - discountPercent/100);

            if(finalPrice < maxMinOrder){
                finalPrice = maxMinOrder;
            }

            session.setAttribute("selectedVouchers", selected);
            session.setAttribute("finalPrice", finalPrice);
            session.setAttribute("discountPercent", discountPercent);

            response.sendRedirect("cart");

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
