1️⃣ Hàm áp voucher theo đúng rule
public class VoucherCalculator {

    public static class Result {
        public double finalAmount;
        public double totalDiscount;
        public List<OrderVoucher> orderVouchers = new ArrayList<>();
    }

    public static Result applyVouchers(double subtotal, List<Voucher> vouchers) {

        Result result = new Result();

        double orderAmount = subtotal;
        double totalDiscount = 0;

        double maxMinOrder = 0;

        for (Voucher v : vouchers) {
            if (v.getMinOrderAmount() > maxMinOrder) {
                maxMinOrder = v.getMinOrderAmount();
            }
        }

        for (Voucher v : vouchers) {

            OrderVoucher ov = new OrderVoucher();

            ov.setVoucherId(v.getVoucherId());
            ov.setOrderAmount(orderAmount);

            double discount = orderAmount * v.getDiscountValue() / 100;

            double afterDiscount = orderAmount - discount;

            if (afterDiscount < maxMinOrder) {
                discount = 0;
                afterDiscount = orderAmount;
            }

            ov.setDiscount(discount);

            orderAmount = afterDiscount;

            totalDiscount += discount;

            result.orderVouchers.add(ov);
        }

        result.finalAmount = orderAmount;
        result.totalDiscount = totalDiscount;

        return result;
    }
}
