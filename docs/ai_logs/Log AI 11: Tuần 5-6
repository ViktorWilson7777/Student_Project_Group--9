<script>
let page = 1;
let loading = false;
let shopSearch = "";

function loadData() {
    if (loading) return;
    loading = true;

    fetch(`variant-load?page=${page}&shop=${shopSearch}`)
        .then(res => res.text())
        .then(data => {

            if (data.trim() === "") return;

            document.getElementById("variantTable")
                    .insertAdjacentHTML("beforeend", data);

            page++;
            loading = false;
        });
}

function search() {
    shopSearch = document.getElementById("searchShop").value;
    page = 1;
    document.getElementById("variantTable").innerHTML = "";
    loadData();
}

window.onload = function() {
    loadData();
}

window.onscroll = function() {
    if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 50) {
        loadData();
    }
}
</script>
