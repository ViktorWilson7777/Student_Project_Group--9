package controller;

import dal.*;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.*;

import java.io.IOException;
import java.util.*;

import model.*;

@WebServlet("/checkout")
public class CheckoutController extends HttpServlet {

    protected void doPost(HttpServletRequest request,
                          HttpServletResponse response)
            throws ServletException, IOException {

        try {

            HttpSession session = request.getSession();

            Map<Integer, CartItem> cart =
                    (Map<Integer, CartItem>) session.getAttribute("cart");

            if (cart == null || cart.isEmpty()) {
                response.sendRedirect("cart");
                return;
            }

            ProductVariantDAO variantDAO = new ProductVariantDAO();

            // =============================
            // 1. CHECK STOCK
            // =============================

            for (CartItem item : cart.values()) {

                ProductVariant variant =
                        variantDAO.getById(item.getVariant().getVariantId());

                if (variant.getStock() < item.getQuantity()) {

                    request.setAttribute("error",
                            "Product " + variant.getProduct().getName()
                                    + " is out of stock or not enough quantity.");

                    request.getRequestDispatcher("cart.jsp")
                            .forward(request, response);

                    return;
                }
            }

            // =============================
            // 2. CALCULATE SUBTOTAL
            // =============================

            double subtotal = 0;

            for (CartItem item : cart.values()) {

                double price = item.getVariant().getPriceVariant();

                subtotal += price * item.getQuantity();
            }

            // =============================
            // 3. APPLY VOUCHERS
            // =============================

            List<Voucher> vouchers =
                    (List<Voucher>) session.getAttribute("selectedVouchers");

            double orderAmount = subtotal;
            double totalDiscount = 0;

            List<OrderVoucher> orderVouchers = new ArrayList<>();

            if (vouchers != null && !vouchers.isEmpty()) {

                double maxMinOrder = 0;

                for (Voucher v : vouchers) {
                    if (v.getMinOrderAmount() > maxMinOrder) {
                        maxMinOrder = v.getMinOrderAmount();
                    }
                }

                for (Voucher v : vouchers) {

                    OrderVoucher ov = new OrderVoucher();

                    ov.setVoucherId(v.getVoucherId());
                    ov.setOrderAmount(orderAmount);

                    double discount =
                            orderAmount * v.getDiscountValue() / 100;

                    double afterDiscount = orderAmount - discount;

                    if (afterDiscount < maxMinOrder) {
                        discount = 0;
                        afterDiscount = orderAmount;
                    }

                    ov.setDiscount(discount);

                    orderAmount = afterDiscount;

                    totalDiscount += discount;

                    orderVouchers.add(ov);
                }
            }

            double totalAmount = orderAmount;

            // =============================
            // 4. CREATE ORDER
            // =============================

            AppUser user = (AppUser) session.getAttribute("user");

            Order order = new Order();

            order.setUserId(user.getUserId());
            order.setOrderDate(new Date());
            order.setStatus(OrderStatus.CREATED);

            order.setSubtotalAmount(subtotal);
            order.setTotalDiscount(totalDiscount);
            order.setTotalAmount(totalAmount);

            OrderDAO orderDAO = new OrderDAO();

            int orderId = orderDAO.insert(order);

            // =============================
            // 5. INSERT ORDER ITEMS
            // =============================

            OrderItemDAO itemDAO = new OrderItemDAO();

            for (CartItem item : cart.values()) {

                OrderItem oi = new OrderItem();

                oi.setOrderId(orderId);
                oi.setVariantId(item.getVariant().getVariantId());
                oi.setQuantity(item.getQuantity());

                double price = item.getVariant().getPriceVariant();

                oi.setPriceSnapshot(price);
                oi.setSubtotal(price * item.getQuantity());

                itemDAO.insert(oi);
            }

            // =============================
            // 6. INSERT ORDER VOUCHERS
            // =============================

            if (!orderVouchers.isEmpty()) {

                OrderVoucherDAO ovDAO = new OrderVoucherDAO();

                for (OrderVoucher ov : orderVouchers) {

                    ov.setOrderId(orderId);

                    ovDAO.insert(ov);
                }
            }

            // =============================
            // 7. UPDATE STOCK
            // =============================

            for (CartItem item : cart.values()) {

                variantDAO.decreaseStock(
                        item.getVariant().getVariantId(),
                        item.getQuantity()
                );
            }

            // =============================
            // 8. CLEAR CART
            // =============================

            session.removeAttribute("cart");
            session.removeAttribute("selectedVouchers");

            response.sendRedirect("order-success.jsp");

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
