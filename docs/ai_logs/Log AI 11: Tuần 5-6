Full code
public void insert(Product p) throws Exception {

    String sql = "INSERT INTO Product (name, price, shopId) VALUES (?, ?, ?)";

    Connection conn = DBContext.getConnection();

    PreparedStatement ps = conn.prepareStatement(
            sql, Statement.RETURN_GENERATED_KEYS);

    ps.setString(1, p.getName());
    ps.setDouble(2, p.getPrice());
    ps.setInt(3, p.getShop().getShopId());

    ps.executeUpdate();

    ResultSet rs = ps.getGeneratedKeys();

    if (rs.next()) {

        int productId = rs.getInt(1);
        p.setProductId(productId);

        // tạo variant mặc định
        String variantSql = """
            INSERT INTO ProductVariant(productId, size, color, stock)
            VALUES (?, NULL, NULL, 0)
        """;

        PreparedStatement ps2 = conn.prepareStatement(variantSql);

        ps2.setInt(1, productId);

        ps2.executeUpdate();
    }
}
