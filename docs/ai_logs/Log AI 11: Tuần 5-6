public List<AppUser> searchUserPaging(String keyword, int offset, int limit) {

    List<AppUser> list = new ArrayList<>();

    String sql = """
        SELECT *
        FROM AppUser
        WHERE name LIKE ?
        ORDER BY userId
        OFFSET ? ROWS FETCH NEXT ? ROWS ONLY
    """;

    try (Connection con = DBContext.getConnection();
         PreparedStatement ps = con.prepareStatement(sql)) {

        ps.setString(1, "%" + keyword + "%");
        ps.setInt(2, offset);
        ps.setInt(3, limit);

        ResultSet rs = ps.executeQuery();

        while (rs.next()) {

            AppUser u = new AppUser(
                    rs.getInt("userId"),
                    rs.getString("name"),
                    rs.getString("email"),
                    rs.getString("password"),
                    rs.getString("role")
            );

            list.add(u);
