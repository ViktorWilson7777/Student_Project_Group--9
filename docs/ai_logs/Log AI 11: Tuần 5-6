@WebServlet("/voucher-create")
public class VoucherCreateController extends HttpServlet {

    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        request.getRequestDispatcher("voucher-create.jsp").forward(request, response);
    }

    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        String code = request.getParameter("code");
        int discount = Integer.parseInt(request.getParameter("discount"));
        double minOrder = Double.parseDouble(request.getParameter("minOrder"));
        boolean stackable = Boolean.parseBoolean(request.getParameter("stackable"));
        String startDate = request.getParameter("startDate");
        String endDate = request.getParameter("endDate");

        VoucherDAO dao = new VoucherDAO();
