public List<Product> getProductPaging(int offset, int limit){

    List<Product> list = new ArrayList<>();

    String sql = """
        SELECT *
        FROM Product
        ORDER BY productId
        OFFSET ? ROWS
        FETCH NEXT ? ROWS ONLY
    """;

    try(Connection conn = DBContext.getConnection();
        PreparedStatement ps = conn.prepareStatement(sql)){

        ps.setInt(1, offset);
        ps.setInt(2, limit);

        ResultSet rs = ps.executeQuery();

        while(rs.next()){

            Shop shop = new Shop(rs.getInt("shopId"));

            Product p = new Product(
                rs.getInt("productId"),
                rs.getString("name"),
                rs.getDouble("price"),
                shop
            );

            list.add(p);
        }

    }catch(Exception e){
        e.printStackTrace();
    }

    return list;
}
