public List<ProductVariant> getVariants(int page, int pageSize, String shop) {

    List<ProductVariant> list = new ArrayList<>();

    String sql = """
        SELECT pv.variantId, pv.size, pv.color, pv.stock, pv.priceVariant,
               p.name AS productName,
               s.shopName
        FROM ProductVariant pv
        JOIN Product p ON pv.productId = p.productId
        JOIN Shop s ON p.shopId = s.shopId
        WHERE (? IS NULL OR s.shopName LIKE ?)
        ORDER BY pv.variantId
        OFFSET ? ROWS FETCH NEXT ? ROWS ONLY
    """;

    try (Connection con = DBContext.getConnection();
         PreparedStatement ps = con.prepareStatement(sql)) {

        if (shop == null || shop.trim().isEmpty()) {
            ps.setNull(1, java.sql.Types.VARCHAR);
            ps.setNull(2, java.sql.Types.VARCHAR);
        } else {
            ps.setString(1, shop);
            ps.setString(2, "%" + shop + "%");
        }

        ps.setInt(3, (page - 1) * pageSize);
        ps.setInt(4, pageSize);

        ResultSet rs = ps.executeQuery();

        while (rs.next()) {

            ProductVariant v = new ProductVariant();

            v.setVariantId(rs.getInt("variantId"));
            v.setSize(rs.getString("size"));
            v.setColor(rs.getString("color"));
            v.setStock(rs.getInt("stock"));
            v.setPriceVariant(rs.getDouble("priceVariant"));

            Product p = new Product();
            p.setName(rs.getString("productName"));

            Shop s = new Shop();
            s.setShopName(rs.getString("shopName"));

            p.setShop(s);
            v.setProduct(p);

            list.add(v);
        }

    } catch (Exception e) {
        e.printStackTrace();
    }

    return list;
}
CREATE
public void insert(ProductVariant v){

    String sql = """
        INSERT INTO ProductVariant(size,color,stock,priceVariant,productId)
        VALUES(?,?,?,?,?)
    """;

    try(Connection con = DBContext.getConnection();
        PreparedStatement ps = con.prepareStatement(sql)){

        ps.setString(1, v.getSize());
        ps.setString(2, v.getColor());
        ps.setInt(3, v.getStock());
        ps.setDouble(4, v.getPriceVariant());
        ps.setInt(5, v.getProduct().getProductId());

        ps.executeUpdate();

    }catch(Exception e){
        e.printStackTrace();
    }
}
GET BY ID
public ProductVariant getById(int id){

    String sql = "SELECT * FROM ProductVariant WHERE variantId=?";

    try(Connection con = DBContext.getConnection();
        PreparedStatement ps = con.prepareStatement(sql)){

        ps.setInt(1,id);

        ResultSet rs = ps.executeQuery();

        if(rs.next()){

            ProductVariant v = new ProductVariant();

            v.setVariantId(rs.getInt("variantId"));
            v.setSize(rs.getString("size"));
            v.setColor(rs.getString("color"));
            v.setStock(rs.getInt("stock"));
            v.setPriceVariant(rs.getDouble("priceVariant"));

            Product p = new Product();
            p.setProductId(rs.getInt("productId"));

            v.setProduct(p);

            return v;
        }

    }catch(Exception e){
        e.printStackTrace();
    }

    return null;
}
UPDATE
public void update(ProductVariant v){

    String sql = """
        UPDATE ProductVariant
        SET size=?, color=?, stock=?, priceVariant=?, productId=?
        WHERE variantId=?
    """;

    try(Connection con = DBContext.getConnection();
        PreparedStatement ps = con.prepareStatement(sql)){

        ps.setString(1, v.getSize());
        ps.setString(2, v.getColor());
        ps.setInt(3, v.getStock());
        ps.setDouble(4, v.getPriceVariant());
        ps.setInt(5, v.getProduct().getProductId());
        ps.setInt(6, v.getVariantId());

        ps.executeUpdate();

    }catch(Exception e){
        e.printStackTrace();
    }
}
DELETE
public void delete(int id){

    String sql = "DELETE FROM ProductVariant WHERE variantId=?";

    try(Connection con = DBContext.getConnection();
        PreparedStatement ps = con.prepareStatement(sql)){

        ps.setInt(1,id);

        ps.executeUpdate();

    }catch(Exception e){
        e.printStackTrace();
    }
}
