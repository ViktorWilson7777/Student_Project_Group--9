🎯 3️⃣ DAO method
public List<ProductVariantDTO> getVariants(int page, int pageSize, String shop) {
    List<ProductVariantDTO> list = new ArrayList<>();
    String sql = """
        SELECT pv.variantId, pv.size, pv.color, pv.stock, pv.priceVariant,
               p.name AS productName, s.shopName
        FROM ProductVariant pv
        JOIN Product p ON pv.productId = p.productId
        JOIN Shop s ON p.shopId = s.shopId
        WHERE (? IS NULL OR s.shopName LIKE ?)
        ORDER BY pv.variantId
        OFFSET ? ROWS FETCH NEXT ? ROWS ONLY
    """;

    try (Connection con = DBContext.getConnection();
         PreparedStatement ps = con.prepareStatement(sql)) {

        if (shop == null || shop.trim().isEmpty()) {
            ps.setNull(1, Types.VARCHAR);
            ps.setNull(2, Types.VARCHAR);
        } else {
            ps.setString(1, shop);
            ps.setString(2, "%" + shop + "%");
        }

        ps.setInt(3, (page - 1) * pageSize);
        ps.setInt(4, pageSize);

        ResultSet rs = ps.executeQuery();
        while (rs.next()) {
            ProductVariantDTO dto = new ProductVariantDTO();
            dto.setVariantId(rs.getInt("variantId"));
            dto.setSize(rs.getString("size"));
            dto.setColor(rs.getString("color"));
            dto.setStock(rs.getInt("stock"));
            dto.setPriceVariant(rs.getDouble("priceVariant"));
            dto.setProductName(rs.getString("productName"));
            dto.setShopName(rs.getString("shopName"));
            list.add(dto);
        }
    }
    return list;
}
🎯 4️⃣ Servlet: LoadVariantsServlet
@WebServlet("/loadVariants")
public class LoadVariantsServlet extends HttpServlet {

    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        int page = Integer.parseInt(request.getParameter("page"));
        String shop = request.getParameter("shop");

        ProductVariantDAO dao = new ProductVariantDAO();
        List<ProductVariantDTO> list = dao.getVariants(page, 10, shop);

        request.setAttribute("list", list);
        request.getRequestDispatcher("variant-rows.jsp")
               .forward(request, response);
    }
}
