public void insert(OrderVoucher ov) throws Exception {

    String sql = "INSERT INTO OrderVoucher (discount, orderAmount, orderId, voucherId) " +
                 "VALUES (?, ?, ?, ?)";

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql)) {

        ps.setDouble(1, ov.getDiscount());
        ps.setDouble(2, ov.getOrderAmount());
        ps.setInt(3, ov.getOrder().getOrderId());
        ps.setInt(4, ov.getVoucher().getVoucherId());

        ps.executeUpdate();
    }
}
3️⃣ getByOrderId
public List<OrderVoucher> getByOrderId(int orderId) throws Exception {

    List<OrderVoucher> list = new ArrayList<>();

    String sql = """
        SELECT ov.*, v.code, v.discountValue
        FROM OrderVoucher ov
        JOIN Voucher v ON ov.voucherId = v.voucherId
        WHERE ov.orderId = ?
    """;

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql)) {

        ps.setInt(1, orderId);
        ResultSet rs = ps.executeQuery();

        while (rs.next()) {

            OrderVoucher ov = new OrderVoucher();

            ov.setId(rs.getInt("id"));
            ov.setDiscount(rs.getDouble("discount"));
            ov.setOrderAmount(rs.getDouble("orderAmount"));

            Voucher v = new Voucher();
            v.setVoucherId(rs.getInt("voucherId"));
            v.setCode(rs.getString("code"));
            v.setDiscountValue(rs.getDouble("discountValue"));

            ov.setVoucher(v);

            list.add(ov);
        }
    }

    return list;
}
