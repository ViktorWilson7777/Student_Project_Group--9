public double applyVouchers(Order order,
                            List<Voucher> selectedVouchers)
                            throws Exception {

    double currentAmount = order.getSubtotalAmount();

    List<OrderVoucher> orderVouchers = new ArrayList<>();

    for (Voucher v : selectedVouchers) {

        OrderVoucher ov = new OrderVoucher();
        ov.setOrder(order);
        ov.setVoucher(v);

        currentAmount = ov.calculateDiscount(currentAmount);

        orderVoucherDAO.insert(ov);
        orderVouchers.add(ov);
    }

    double totalDiscount = orderVouchers.stream()
            .mapToDouble(OrderVoucher::getDiscount)
            .sum();

    order.setTotalDiscount(totalDiscount);
    order.setTotalAmount(currentAmount);

    orderDAO.updateAmounts(order);

    return currentAmount;
}
