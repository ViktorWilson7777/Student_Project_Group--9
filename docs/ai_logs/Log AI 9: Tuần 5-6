🎯 I. ORDER VOUCHER MODEL
1️⃣ OrderVoucher.java
package model;

public class OrderVoucher {

    private int id;
    private double discount;     // số tiền được giảm
    private double orderAmount;  // số tiền còn lại sau khi áp voucher này
    private Order order;
    private Voucher voucher;

    // ================= BUSINESS METHODS =================

    public double calculateDiscount(double currentAmount) {

        if (!voucher.isApplicable(currentAmount)) {
            discount = 0;
            orderAmount = currentAmount;
            return currentAmount;
        }

        double discountValue = voucher.applyDiscount(currentAmount);

        // Không cho giảm vượt quá currentAmount
        discount = Math.min(discountValue, currentAmount);

        orderAmount = currentAmount - discount;

        return orderAmount;
    }

    // ================= GETTER SETTER =================

    public int getId() { return id; }
    public void setId(int id) { this.id = id; }

    public double getDiscount() { return discount; }
    public void setDiscount(double discount) { this.discount = discount; }

    public double getOrderAmount() { return orderAmount; }
    public void setOrderAmount(double orderAmount) { this.orderAmount = orderAmount; }

    public Order getOrder() { return order; }
    public void setOrder(Order order) { this.order = order; }

    public Voucher getVoucher() { return voucher; }
    public void setVoucher(Voucher voucher) { this.voucher = voucher; }
}
