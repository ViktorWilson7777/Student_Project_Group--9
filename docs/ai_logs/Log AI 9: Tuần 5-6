package model;

import java.time.LocalDateTime;

public class Voucher {

    private int voucherId;
    private String code;
    private double discountValue;
    private int minOrderAmount;
    private boolean stackable;
    private LocalDateTime startDate;
    private LocalDateTime endDate;

    public Voucher() {}

    public Voucher(int voucherId, String code, double discountValue,
                   int minOrderAmount, boolean stackable,
                   LocalDateTime startDate, LocalDateTime endDate) {
        this.voucherId = voucherId;
        this.code = code;
        this.discountValue = discountValue;
        this.minOrderAmount = minOrderAmount;
        this.stackable = stackable;
        this.startDate = startDate;
        this.endDate = endDate;
    }

    public boolean isOutOfDate(LocalDateTime now) {
        return now.isBefore(startDate) || now.isAfter(endDate);
    }

    public boolean isApplicable(double orderAmount) {
        return orderAmount >= minOrderAmount;
    }

    public double applyDiscount(double orderAmount) {
        if (orderAmount >= minOrderAmount) {
            return Math.min(discountValue, orderAmount);
        }
        return 0;
    }

    // getters setters đầy đủ
}
