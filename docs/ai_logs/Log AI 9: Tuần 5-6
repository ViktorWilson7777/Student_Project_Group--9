@WebServlet("/apply-voucher")
public class ApplyVoucherServlet extends HttpServlet {

    private VoucherDAO voucherDAO = new VoucherDAO();

    protected void doPost(HttpServletRequest request,
                          HttpServletResponse response)
            throws ServletException, IOException {

        try {

            String code = request.getParameter("code");

            Voucher voucher = voucherDAO.getByCode(code);

            if (voucher == null) {
                request.setAttribute("error", "Voucher not found");
                request.getRequestDispatcher("checkout.jsp")
                       .forward(request, response);
                return;
            }

            List<Voucher> selected =
                    (List<Voucher>) request.getSession()
                                           .getAttribute("selectedVouchers");

            if (selected == null) {
                selected = new ArrayList<>();
            }

            selected.add(voucher);

            request.getSession().setAttribute("selectedVouchers", selected);

            response.sendRedirect("checkout");

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
