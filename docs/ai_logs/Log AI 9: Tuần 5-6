public List<OrderItem> getByOrderId(int orderId) throws Exception {

    List<OrderItem> list = new ArrayList<>();

    String sql = """
        SELECT oi.*, pv.size, pv.color, pv.priceVariant
        FROM OrderItem oi
        JOIN ProductVariant pv ON oi.variantId = pv.variantId
        WHERE oi.orderId = ?
    """;

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql)) {

        ps.setInt(1, orderId);
        ResultSet rs = ps.executeQuery();

        while (rs.next()) {

            OrderItem item = new OrderItem();

            item.setOrderItemId(rs.getInt("orderItemId"));
            item.setQuantity(rs.getInt("quantity"));
            item.setSubtotal(rs.getDouble("subtotal"));
            item.setPriceSnapshot(rs.getDouble("priceSnapshot"));

            ProductVariant variant = new ProductVariant();
            variant.setVariantId(rs.getInt("variantId"));
            variant.setSize(rs.getString("size"));
            variant.setColor(rs.getString("color"));
            variant.setPriceVariant(rs.getDouble("priceVariant"));

            item.setProductVariant(variant);

            list.add(item);
        }
    }
    return list;
}
