public int insert(Order order) throws Exception {

    String sql = "INSERT INTO [Order] (orderDate, status, subtotalAmount, totalDiscount, totalAmount, userId) " +
                 "VALUES (?, ?, ?, ?, ?, ?)";

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql, Statement.RETURN_GENERATED_KEYS)) {

        ps.setTimestamp(1, Timestamp.valueOf(order.getOrderDate()));
        ps.setString(2, order.getStatus().name());
        ps.setDouble(3, order.getSubtotalAmount());
        ps.setDouble(4, order.getTotalDiscount());
        ps.setDouble(5, order.getTotalAmount());
        ps.setInt(6, order.getUser().getUserId());

        ps.executeUpdate();

        ResultSet rs = ps.getGeneratedKeys();
        if (rs.next()) {
            return rs.getInt(1);
        }
    }
    return -1;
}
