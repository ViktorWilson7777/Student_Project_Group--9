public List<Order> getByUser(int userId) throws Exception {

    List<Order> list = new ArrayList<>();

    String sql = "SELECT * FROM [Order] WHERE userId = ? ORDER BY orderDate DESC";

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql)) {

        ps.setInt(1, userId);
        ResultSet rs = ps.executeQuery();

        while (rs.next()) {

            Order o = new Order();
            o.setOrderId(rs.getInt("orderId"));
            o.setOrderDate(rs.getTimestamp("orderDate").toLocalDateTime());
            o.setStatus(OrderStatus.valueOf(rs.getString("status")));
            o.setSubtotalAmount(rs.getDouble("subtotalAmount"));
            o.setTotalDiscount(rs.getDouble("totalDiscount"));
            o.setTotalAmount(rs.getDouble("totalAmount"));

            list.add(o);
        }
    }
    return list;
}
