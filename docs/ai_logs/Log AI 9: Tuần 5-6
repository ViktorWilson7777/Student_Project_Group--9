public void insert(Shop shop) {

    String sql = "INSERT INTO Shop (shopName, ownerId) VALUES (?, ?)";

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql)) {

        ps.setString(1, shop.getShopName());
        ps.setInt(2, shop.getOwner().getUserId());

        ps.executeUpdate();

    } catch (Exception e) {
        e.printStackTrace();
    }
}
4️⃣ READ — Lấy shop theo ownerId
public Shop getByOwnerId(int ownerId) {

    String sql = "SELECT * FROM Shop WHERE ownerId = ?";

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql)) {

        ps.setInt(1, ownerId);
        ResultSet rs = ps.executeQuery();

        if (rs.next()) {

            AppUser owner = new AppUser();
            owner.setUserId(rs.getInt("ownerId"));

            return new Shop(
                rs.getInt("shopId"),
                rs.getString("shopName"),
                owner
            );
        }

    } catch (Exception e) {
        e.printStackTrace();
    }

    return null;
}
