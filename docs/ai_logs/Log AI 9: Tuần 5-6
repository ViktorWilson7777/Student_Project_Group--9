public void checkout(AppUser user,
                     List<CartItem> cart,
                     List<Voucher> selectedVouchers,
                     Shipping shippingInfo) {

    Order order = new Order();
    order.setUser(user);
    order.setStatus("PENDING");

    // 1️⃣ Create Order

    int orderId = orderDAO.insertAndReturnId(order);

    double subtotal = 0;

    for (CartItem c : cart) {

        OrderItem item = new OrderItem();
        item.setOrder(order);
        item.setQuantity(c.getQuantity());
        item.setPriceSnapshot(c.getVariant().getPriceVariant());

        double itemSubtotal = item.calculateSubtotal();
        subtotal += itemSubtotal;

        orderItemDAO.insert(item);
    }

    order.setSubtotalAmount(subtotal);

    double currentAmount = subtotal;

    List<OrderVoucher> orderVouchers = new ArrayList<>();

    for (Voucher v : selectedVouchers) {

        OrderVoucher ov = new OrderVoucher();
        ov.setOrder(order);
        ov.setVoucher(v);

        currentAmount = ov.calculateDiscount(currentAmount);

        orderVoucherDAO.insert(ov);
        orderVouchers.add(ov);
    }

    order.calculateTotalDiscount(orderVouchers);
    order.setTotalAmount(currentAmount);

    orderDAO.updateAmounts(order);

    // 4️⃣ Create Shipping
    shippingInfo.setOrder(order);
    shippingDAO.insert(shippingInfo);
}
