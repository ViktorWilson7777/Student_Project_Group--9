import java.time.LocalDateTime;

public double calculateDiscount(double currentAmount) {

    try {

        double discountValue =
                voucher.applyDiscount(currentAmount, LocalDateTime.now());

        discount = Math.min(discountValue, currentAmount);
        orderAmount = currentAmount - discount;

        return orderAmount;

    } catch (RuntimeException e) {

        // Nếu voucher không hợp lệ hoặc hết hạn
        discount = 0;
        orderAmount = currentAmount;
        return currentAmount;
    }
}
