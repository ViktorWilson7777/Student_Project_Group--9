2️⃣ GET ALL PRODUCT BY SHOP
public List<Product> getByShopId(int shopId) {

    List<Product> list = new ArrayList<>();

    String sql = "SELECT * FROM Product WHERE shopId = ?";

    try (Connection conn = DBContext.getConnection();
         PreparedStatement ps = conn.prepareStatement(sql)) {

        ps.setInt(1, shopId);
        ResultSet rs = ps.executeQuery();

        while (rs.next()) {

            Shop shop = new Shop();
            shop.setShopId(rs.getInt("shopId"));

            Product p = new Product(
                rs.getInt("productId"),
                rs.getString("name"),
                rs.getDouble("price"),
                shop
            );

            list.add(p);
        }

    } catch (Exception e) {
