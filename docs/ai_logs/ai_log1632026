<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>${product.productName}</title>
    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family: Arial, sans-serif;
        }

        body{
            background:#f5f5f5;
            color:#222;
        }

        /* HEADER */
        .topbar{
            background:linear-gradient(180deg,#f53d2d,#ff6633);
            color:#fff;
        }

        .topbar-inner{
            max-width:1200px;
            margin:0 auto;
            padding:14px 20px 10px;
        }

        .topbar-row1{
            display:flex;
            justify-content:space-between;
            align-items:center;
            font-size:13px;
            margin-bottom:12px;
        }

        .topbar-row1 a{
            color:#fff;
            text-decoration:none;
            margin-right:14px;
        }

        .topbar-row2{
            display:flex;
            align-items:center;
            gap:24px;
        }

        .logo{
            font-size:34px;
            font-weight:700;
            white-space:nowrap;
        }

        .search-box{
            flex:1;
            display:flex;
            background:#fff;
            border-radius:3px;
            overflow:hidden;
            height:40px;
        }

        .search-box input{
            flex:1;
            border:none;
            outline:none;
            padding:0 14px;
            font-size:14px;
        }

        .search-box button{
            width:60px;
            border:none;
            background:#fb5533;
            color:#fff;
            font-size:18px;
            cursor:pointer;
        }

        .cart-link{
            color:#fff;
            text-decoration:none;
            font-size:26px;
            white-space:nowrap;
        }

        /* BREADCRUMB */
        .breadcrumb{
            max-width:1200px;
            margin:20px auto 15px;
            font-size:13px;
            color:#666;
        }

        .breadcrumb a{
            color:#0055aa;
            text-decoration:none;
        }

        /* MAIN DETAIL */
        .detail-wrapper{
            max-width:1200px;
            margin:0 auto 30px;
            background:#fff;
            display:grid;
            grid-template-columns: 440px 1fr;
            gap:32px;
            padding:25px;
        }

        /* LEFT */
        .left-panel{
            width:100%;
        }

        .main-image-box{
            width:100%;
            aspect-ratio:1/1;
            border:1px solid #eee;
            background:#fafafa;
            display:flex;
            align-items:center;
            justify-content:center;
            overflow:hidden;
        }

        .main-image-box img{
            width:100%;
            height:100%;
            object-fit:contain;
        }

        .thumb-list{
            margin-top:15px;
            display:flex;
            gap:10px;
            overflow-x:auto;
        }

        .thumb-item{
            width:78px;
            height:78px;
            border:2px solid transparent;
            cursor:pointer;
            background:#fff;
            flex:0 0 auto;
        }

        .thumb-item.active{
            border-color:#ee4d2d;
        }

        .thumb-item img{
            width:100%;
            height:100%;
            object-fit:cover;
        }

        /* RIGHT */
        .product-title{
            font-size:28px;
            font-weight:500;
            line-height:1.35;
            margin-bottom:12px;
        }

        .meta-row{
            display:flex;
            align-items:center;
            gap:18px;
            color:#666;
            font-size:14px;
            margin-bottom:18px;
        }

        .meta-row .rating{
            color:#ee4d2d;
            font-weight:600;
        }

        .price-box{
            background:#fafafa;
            padding:18px 20px;
            margin-bottom:22px;
            display:flex;
            align-items:end;
            gap:12px;
            flex-wrap:wrap;
        }

        .old-price{
            color:#929292;
            text-decoration:line-through;
            font-size:20px;
        }

        .new-price{
            color:#ee4d2d;
            font-size:34px;
            font-weight:500;
        }

        .discount-tag{
            background:#ee4d2d;
            color:#fff;
            padding:3px 8px;
            font-size:13px;
            border-radius:2px;
        }

        .section{
            margin-bottom:22px;
        }

        .section-title{
            width:110px;
            color:#757575;
            font-size:15px;
            padding-top:10px;
            flex-shrink:0;
        }

        .section-row{
            display:flex;
            align-items:flex-start;
            margin-bottom:18px;
        }

        .option-list{
            display:flex;
            flex-wrap:wrap;
            gap:10px;
            max-height:180px;
            overflow-y:auto;
        }

        .option-btn{
            min-width:90px;
            padding:10px 14px;
            border:1px solid #d5d5d5;
            background:#fff;
            cursor:pointer;
            font-size:14px;
            transition:all .2s ease;
        }

        .option-btn:hover{
            border-color:#ee4d2d;
            color:#ee4d2d;
        }

        .option-btn.active{
            border:1px solid #ee4d2d;
            color:#ee4d2d;
            position:relative;
        }

        .option-btn.disabled{
            color:#bbb;
            border-color:#e8e8e8;
            background:#fafafa;
            cursor:not-allowed;
        }

        .stock-text{
            font-size:15px;
            color:#555;
            padding-top:10px;
        }

        .qty-box{
            display:flex;
            align-items:center;
            gap:15px;
        }

        .qty-control{
            display:flex;
            align-items:center;
            border:1px solid #ccc;
            width:max-content;
        }

        .qty-control button{
            width:32px;
            height:32px;
            border:none;
            background:#fff;
            cursor:pointer;
            font-size:18px;
        }

        .qty-control input{
            width:52px;
            height:32px;
            border:none;
            border-left:1px solid #ccc;
            border-right:1px solid #ccc;
            text-align:center;
            outline:none;
        }

        .action-row{
            display:flex;
            gap:15px;
            margin-top:28px;
        }

        .btn-cart{
            min-width:180px;
            height:48px;
            border:1px solid #ee4d2d;
            background:#fff1ee;
            color:#ee4d2d;
            font-size:16px;
            cursor:pointer;
        }

        .btn-buy{
            min-width:180px;
            height:48px;
            border:none;
            background:#ee4d2d;
            color:#fff;
            font-size:16px;
            cursor:pointer;
        }

        .btn-cart:hover,
        .btn-buy:hover{
            opacity:.92;
        }

        @media(max-width: 992px){
            .detail-wrapper{
                grid-template-columns:1fr;
            }

            .section-row{
                flex-direction:column;
                gap:8px;
            }

            .section-title{
                width:auto;
                padding-top:0;
            }
        }
    </style>
</head>
