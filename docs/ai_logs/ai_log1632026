/* HEADER */
.header{
    background:#ee4d2d;
    color:white;
    padding:15px 0;
}

.header-container{
    width:1200px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-size:26px;
    font-weight:bold;
}

.search-bar{
    width:500px;
    display:flex;
}

.search-bar input{
    flex:1;
    padding:10px;
    border:none;
    outline:none;
    border-radius:3px 0 0 3px;
}

.search-bar button{
    background:#ff7337;
    border:none;
    padding:10px 20px;
