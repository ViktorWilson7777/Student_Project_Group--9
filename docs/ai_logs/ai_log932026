            PrintWriter out = response.getWriter();
            Gson gson = new Gson();

            out.print(gson.toJson(list));

        } else {

            // mở trang JSP
            request.getRequestDispatcher("product-variant-list.jsp")
                    .forward(request, response);
        }
    }
}

