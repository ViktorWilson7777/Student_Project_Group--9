function loadPage(url){
fetch(url)
.then(res => res.text())
.then(data =>{

let content = document.getElementById("content-area");
content.innerHTML = data;

let scripts = content.getElementsByTagName("script");

for(let i=0;i<scripts.length;i++){
eval(scripts[i].innerText);
}

});
}
