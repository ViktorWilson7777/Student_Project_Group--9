1️⃣ Home.jsp sau khi sửa
Thay toàn bộ home.jsp bằng:

<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<link rel="stylesheet" href="css/dashboard.css">

<div class="layout">

    <!-- SIDEBAR -->
    <div class="sidebar">

        <h2 class="logo">Shopee Admin</h2>

        <ul>

            <li onclick="loadPage('home-content.jsp')">🏠 Dashboard</li>

            <c:if test="${sessionScope.account.role == 'admin'}">

            <li onclick="loadPage('app-user-list')">👤 Users</li>

            <li onclick="loadPage('shop-list')">🏪 Shops</li>

            <li onclick="loadPage('product-list')">📦 Products</li>

            <li onclick="loadPage('product-variant-list')">🎨 Variants</li>

            <li onclick="loadPage('voucher-list')">🎟 Vouchers</li>

            </c:if>

        </ul>

    </div>



    <!-- MAIN -->
    <div class="main">

        <!-- TOPBAR -->
        <div class="topbar">

            <div>
                Welcome <b>${sessionScope.account.name}</b>
                (Role: ${sessionScope.account.role})
            </div>

            <div>

                <a href="me">Profile</a> |

                <a href="logout">Logout</a>

            </div>

        </div>



        <!-- CONTENT -->
        <div class="content" id="content-area">

            <h2>Dashboard</h2>

            <p>Select module to manage</p>

        </div>

    </div>

</div>



<script>

function loadPage(url){

    fetch(url)

    .then(res => res.text())

    .then(data =>{

        document.getElementById("content-area").innerHTML = data;

    });

}

</script>
