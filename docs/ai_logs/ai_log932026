@WebServlet("/app-user-list")
public class AppUserListController extends HttpServlet {

    protected void doGet(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        String keyword = request.getParameter("keyword");
        if (keyword == null) keyword = "";

        int page = 1;
        int limit = 20;

        if (request.getParameter("page") != null) {
            page = Integer.parseInt(request.getParameter("page"));
        }

        int offset = (page - 1) * limit;

        AppUserDAO dao = new AppUserDAO();

        List<AppUser> list = dao.searchUserPaging(keyword, offset, limit);

        String ajax = request.getParameter("ajax");

        if ("true".equals(ajax)) {

            response.setContentType("application/json");
            response.setCharacterEncoding("UTF-8");

            Gson gson = new Gson();
            response.getWriter().print(gson.toJson(list));

        } else {

            request.setAttribute("list", list);
            request.setAttribute("keyword", keyword);

            request.getRequestDispatcher("user-list.jsp")
                    .forward(request, response);
        }
    }
}
